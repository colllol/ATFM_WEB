<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.9" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="README.md" CopyToPublishDirectory="PreserveNewest" />
    <None Update=".env.example" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <Target Name="CopyDotEnvToBuildOutput" AfterTargets="Build" Condition="'$(PublishDir)' == ''">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\.env.example"
          DestinationFiles="$(TargetDir).env"
          Condition="Exists('$(MSBuildProjectDirectory)\.env.example') and !Exists('$(TargetDir).env')" />
  </Target>

  <Target Name="CopyDotEnvToPublishOutput" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\.env.example"
          DestinationFiles="$(PublishDir).env"
          Condition="Exists('$(MSBuildProjectDirectory)\.env.example') and !Exists('$(PublishDir).env')" />
  </Target>

</Project>
