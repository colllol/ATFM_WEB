<%@ Page Title="Airport Comparison" Language="C#" MasterPageFile="~/Masters/ATFM_New.Master" AutoEventWireup="true" CodeBehind="ChartReportAirport.aspx.cs" Inherits="prjApplication.Common.ChartReportAirport" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server">
<style>
 .airport-page{--blue:#337ab7;--orange:#f5a623;color:#243b53}.airport-title{margin:0 0 18px}.airport-title h2{margin:0 0 5px;color:#163f63;font-size:25px}.airport-title p{margin:0;color:#718096}.airport-filter,.airport-chart-card,.airport-legend{border:1px solid #dce7f0;border-radius:15px;background:#fff;box-shadow:0 8px 24px rgba(31,55,78,.08)}.airport-filter{display:grid;grid-template-columns:140px minmax(155px,1fr) minmax(155px,1fr) 150px 150px 125px;gap:10px;align-items:end;padding:16px;margin-bottom:20px}.airport-filter>div{min-width:0}.airport-filter label{display:block;margin-bottom:6px;color:#52677a;font-size:11px;font-weight:700;white-space:nowrap}.airport-filter select,.airport-filter input{width:100%;height:38px;padding:7px 10px;border:1px solid #ccdce8;border-radius:7px;background:#fff;color:#294c68}.airport-filter button{width:100%;height:38px;padding:0 14px;border:0;border-radius:7px;background:var(--blue);color:#fff;font-weight:700;white-space:nowrap;cursor:pointer}.airport-filter button:hover{background:#286090}.airport-filter button:disabled{cursor:wait;opacity:.65}.airport-chart-card{padding:22px}.airport-chart-layout{display:grid;grid-template-columns:minmax(0,1fr) 235px;gap:24px;align-items:center}.airport-chart-title{margin:0;color:#294c68;font-size:17px}.airport-chart-subtitle{margin:5px 0 18px;color:#8393a3;font-size:12px}.bar-chart{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;min-height:310px;padding:10px 12px 0 38px;border-bottom:1px solid #cbd8e2;background:repeating-linear-gradient(to bottom,transparent 0,transparent 59px,#edf2f6 60px)}.bar-group{display:flex;align-items:flex-end;justify-content:center;gap:5px;min-width:0;height:290px}.bar{position:relative;width:28px;max-width:42%;min-height:3px;border-radius:7px 7px 0 0;cursor:pointer;transition:filter .2s,opacity .2s}.bar:hover{filter:brightness(1.12);opacity:.85}.bar-a{background:var(--blue)}.bar-b{background:var(--orange)}.bar-value{position:absolute;top:-21px;left:50%;transform:translateX(-50%);font-size:11px;font-weight:700;color:#456078}.bar-labels{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;padding:10px 12px 0 38px;text-align:center;color:#52677a;font-size:11px;font-weight:700}.airport-legend{padding:18px}.airport-legend h3{margin:0 0 15px;color:#294c68;font-size:16px}.legend-item{display:flex;align-items:center;gap:9px;margin:12px 0;color:#52677a;font-size:12px}.legend-dot{width:12px;height:12px;border-radius:50%}.legend-item strong{margin-left:auto;color:#294c68}.airport-empty{padding:70px 20px;text-align:center;color:#8795a3}.airport-error{padding:25px;border-radius:10px;background:#fff5f5;color:#b33}.airport-y-axis{position:absolute;display:flex;flex-direction:column;justify-content:space-between;height:290px;margin-top:10px;color:#91a0ad;font-size:10px;text-align:right}.bar-area{position:relative}@media(max-width:1050px){.airport-filter{grid-template-columns:repeat(3,minmax(0,1fr))}.airport-chart-layout{grid-template-columns:1fr}}@media(max-width:700px){.airport-filter{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:560px){.airport-filter{grid-template-columns:1fr}.bar{width:19px}.bar-chart{padding-left:28px}.bar-labels{padding-left:28px;font-size:9px}}
 .airport-filter{display:flex;flex-wrap:nowrap;gap:8px}.airport-filter>div{flex:1 1 110px}.airport-filter .airport-count{flex:0 0 120px}.airport-filter>button{flex:0 0 120px}@media(max-width:1050px){.airport-filter{flex-wrap:wrap}.airport-filter>div{flex-basis:calc(33.333% - 8px)}}@media(max-width:700px){.airport-filter>div{flex-basis:calc(50% - 8px)}}
</style>
<section class="airport-page" data-endpoint="<%= ResolveUrl("~/Common/ChartReportAirport.aspx/GetData") %>">
 <div class="airport-title"><h2>So sánh hoạt động sân bay</h2><p>So sánh số lượng chuyến bay theo sân bay và thời điểm</p></div>
 <div class="airport-filter">
  <div class="airport-count"><label for="airportCount">Số lượng sân bay</label><select id="airportCount"><option value="1">1 sân bay</option><option value="2">2 sân bay</option><option value="3">3 sân bay</option><option value="4">4 sân bay</option><option value="5">5 sân bay</option></select></div>
  <div class="airport-choice" data-airport-index="1"><label for="airport1">Sân bay 1</label><select id="airport1" data-searchable="true"></select></div>
  <div class="airport-choice" data-airport-index="2"><label for="airport2">Sân bay 2</label><select id="airport2" data-searchable="true"></select></div>
  <div class="airport-choice" data-airport-index="3"><label for="airport3">Sân bay 3</label><select id="airport3" data-searchable="true"></select></div>
  <div class="airport-choice" data-airport-index="4"><label for="airport4">Sân bay 4</label><select id="airport4" data-searchable="true"></select></div>
  <div class="airport-choice" data-airport-index="5"><label for="airport5">Sân bay 5</label><select id="airport5" data-searchable="true"></select></div>
  <div><label for="time1">Thời gian 1</label><input id="time1" type="date" /></div><div id="time2Wrap"><label id="time2Label" for="time2">Thời gian 2</label><input id="time2" type="date" /></div>
  <button type="button" id="compareButton">So sánh</button>
 </div>
 <div id="airportResult" class="airport-chart-card"><div class="airport-empty">Đang tải dữ liệu từ T_FINISHED_FLIGHTS...</div></div>
</section>
<link rel="stylesheet" href="<%= ResolveUrl("~/ReportNew/ReportInteractive.css?v=20260724-1") %>" />
<script src="<%= ResolveUrl("~/ReportNew/ReportControls.js?v=20260724-1") %>"></script>
<script src="<%= ResolveUrl("~/Common/ChartReportAirport.js") %>?v=20260724-4"></script>
</asp:Content>
