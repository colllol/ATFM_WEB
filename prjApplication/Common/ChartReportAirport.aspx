<%@ Page Title="Airport Comparison" Language="C#" MasterPageFile="~/Masters/ATFM_New.Master" AutoEventWireup="true" CodeBehind="ChartReportAirport.aspx.cs" Inherits="prjApplication.Common.ChartReportAirport" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server">
<style>
 .airport-page{--blue:#337ab7;--orange:#f5a623;color:#243b53}.airport-title{margin:0 0 18px}.airport-title h2{margin:0 0 5px;color:#163f63;font-size:25px}.airport-title p{margin:0;color:#718096}.airport-filter,.airport-chart-card,.airport-legend{border:1px solid #dce7f0;border-radius:15px;background:#fff;box-shadow:0 8px 24px rgba(31,55,78,.08)}.airport-filter{display:grid;grid-template-columns:170px repeat(2,minmax(210px,1fr)) auto;gap:14px;align-items:end;padding:18px;margin-bottom:20px}.airport-filter label{display:block;margin-bottom:6px;color:#52677a;font-size:12px;font-weight:700}.airport-filter select,.airport-filter input{width:100%;height:38px;padding:7px 10px;border:1px solid #ccdce8;border-radius:7px;background:#fff;color:#294c68}.airport-filter button{height:38px;padding:0 18px;border:0;border-radius:7px;background:var(--blue);color:#fff;font-weight:700;cursor:pointer}.airport-filter button:hover{background:#286090}.airport-chart-card{padding:22px}.airport-chart-layout{display:grid;grid-template-columns:minmax(0,1fr) 235px;gap:24px;align-items:center}.airport-chart-title{margin:0;color:#294c68;font-size:17px}.airport-chart-subtitle{margin:5px 0 18px;color:#8393a3;font-size:12px}.bar-chart{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;min-height:310px;padding:10px 12px 0 38px;border-bottom:1px solid #cbd8e2;background:repeating-linear-gradient(to bottom,transparent 0,transparent 59px,#edf2f6 60px)}.bar-group{display:flex;align-items:flex-end;justify-content:center;gap:5px;min-width:0;height:290px}.bar{position:relative;width:28px;max-width:42%;min-height:3px;border-radius:7px 7px 0 0;cursor:pointer;transition:filter .2s,opacity .2s}.bar:hover{filter:brightness(1.12);opacity:.85}.bar-a{background:var(--blue)}.bar-b{background:var(--orange)}.bar-value{position:absolute;top:-21px;left:50%;transform:translateX(-50%);font-size:11px;font-weight:700;color:#456078}.bar-labels{display:grid;grid-template-columns:repeat(5,1fr);gap:10px;padding:10px 12px 0 38px;text-align:center;color:#52677a;font-size:11px;font-weight:700}.airport-legend{padding:18px}.airport-legend h3{margin:0 0 15px;color:#294c68;font-size:16px}.legend-item{display:flex;align-items:center;gap:9px;margin:12px 0;color:#52677a;font-size:12px}.legend-dot{width:12px;height:12px;border-radius:50%}.legend-item strong{margin-left:auto;color:#294c68}.airport-empty{padding:70px 20px;text-align:center;color:#8795a3}.airport-error{padding:25px;border-radius:10px;background:#fff5f5;color:#b33}.airport-y-axis{position:absolute;display:flex;flex-direction:column;justify-content:space-between;height:290px;margin-top:10px;color:#91a0ad;font-size:10px;text-align:right}.bar-area{position:relative}@media(max-width:900px){.airport-filter{grid-template-columns:repeat(2,1fr)}.airport-filter .airport-count{grid-column:1/-1}.airport-chart-layout{grid-template-columns:1fr}}@media(max-width:560px){.airport-filter{grid-template-columns:1fr}.airport-filter .airport-count{grid-column:auto}.bar{width:19px}.bar-chart{padding-left:28px}.bar-labels{padding-left:28px;font-size:9px}}
</style>
<section class="airport-page">
 <div class="airport-title"><h2>So sánh hoạt động sân bay</h2><p>So sánh số lượng chuyến bay theo sân bay và thời điểm</p></div>
 <div class="airport-filter">
  <div class="airport-count"><label for="airportCount">Số lượng sân bay</label><select id="airportCount"><option value="1">1 sân bay</option><option value="2">2 sân bay</option></select></div>
  <div><label for="airport1">Sân bay 1</label><select id="airport1"></select></div><div id="airport2Wrap"><label for="airport2">Sân bay 2</label><select id="airport2"></select></div>
  <div><label for="time1">Thời gian 1</label><input id="time1" type="date" /></div><div id="time2Wrap"><label id="time2Label" for="time2">Thời gian 2</label><input id="time2" type="date" /></div>
  <button type="button" id="compareButton">So sánh</button>
 </div>
 <div id="airportResult" class="airport-chart-card"><div class="airport-empty">Vui lòng chọn sân bay và thời gian, sau đó nhấn <strong>So sánh</strong>.</div></div>
</section>
<script>
(function(){var dataUrl='<%= ResolveUrl("~/Data/dashboard-flights.json") %>',flights=[],statuses=[['total','Tổng chuyến bay','#244b74'],['finished','Finished','#20b486'],['cancel','Cancel','#ef5b5b'],['delay','Delay','#f5a623'],['wait','Wait','#4d8df7']];
 function esc(v){var n=document.createElement('div');n.appendChild(document.createTextNode(v||''));return n.innerHTML} function dateKey(v){var p=(v||'').split('/');return p.length===3?p[2]+'-'+p[1]+'-'+p[0]:v} function airports(){var m={},a=[];flights.forEach(function(f){if(!m[f.from]){m[f.from]=1;a.push(f.from)}if(!m[f.to]){m[f.to]=1;a.push(f.to)}});return a.sort()}
 function fill(){var a=airports(),html='';a.forEach(function(x){html+='<option value="'+esc(x)+'">'+esc(x)+'</option>'});document.getElementById('airport1').innerHTML=html;document.getElementById('airport2').innerHTML=html;document.getElementById('airport2').selectedIndex=Math.min(1,a.length-1);var today=flights[0]?dateKey(flights[0].flightDate):'';document.getElementById('time1').value=today;document.getElementById('time2').value=today;}
 function values(airport,date){var rows=flights.filter(function(f){return dateKey(f.flightDate)===date&&(f.from===airport||f.to===airport)}),v={total:rows.length,finished:0,cancel:0,delay:0,wait:0};rows.forEach(function(f){if(v[f.status]!=null)v[f.status]++});return v}
 function render(){var count=document.getElementById('airportCount').value, a1=document.getElementById('airport1').value,a2=document.getElementById('airport2').value,d1=document.getElementById('time1').value,d2=document.getElementById('time2').value;if(!a1||!d1||!d2||(count==='2'&&!a2)){document.getElementById('airportResult').innerHTML='<div class="airport-empty">Vui lòng nhập đủ sân bay và thời gian để so sánh.</div>';return}var v1=values(a1,d1),v2=count==='2'?values(a2,d2):values(a1,d2),secondName=count==='2'?a2:a1,max=1;statuses.forEach(function(s){max=Math.max(max,v1[s[0]],v2[s[0]])});var chart='<div class="airport-chart-layout"><div><h3 class="airport-chart-title">Số lượng chuyến bay</h3><p class="airport-chart-subtitle">'+esc(a1)+' · '+esc(d1)+' &nbsp;|&nbsp; '+esc(secondName)+' · '+esc(d2)+'</p><div class="bar-area"><div class="airport-y-axis"><span>'+max+'</span><span>'+Math.round(max*.75)+'</span><span>'+Math.round(max*.5)+'</span><span>'+Math.round(max*.25)+'</span><span>0</span></div><div class="bar-chart">';statuses.forEach(function(s){chart+='<div class="bar-group"><div class="bar bar-a" style="height:'+Math.max(3,v1[s[0]]/max*100)+'%"><span class="bar-value">'+v1[s[0]]+'</span></div><div class="bar bar-b" style="height:'+Math.max(3,v2[s[0]]/max*100)+'%"><span class="bar-value">'+v2[s[0]]+'</span></div></div>'});chart+='</div><div class="bar-labels">';statuses.forEach(function(s){chart+='<span>'+s[1]+'</span>'});chart+='</div></div></div><div class="airport-legend"><h3>Chú thích</h3><div class="legend-item"><i class="legend-dot" style="background:#337ab7"></i>'+esc(a1)+'<strong>'+esc(d1)+'</strong></div><div class="legend-item"><i class="legend-dot" style="background:#f5a623"></i>'+esc(secondName)+'<strong>'+esc(d2)+'</strong></div><hr>';statuses.forEach(function(s){chart+='<div class="legend-item"><i class="legend-dot" style="background:'+s[2]+'"></i>'+s[1]+'<strong>'+v1[s[0]]+' / '+v2[s[0]]+'</strong></div>'});chart+='</div></div>';document.getElementById('airportResult').innerHTML=chart}
 document.getElementById('airportCount').onchange=function(){var two=this.value==='2';document.getElementById('airport2Wrap').style.display=two?'block':'none';document.getElementById('time2Label').innerHTML=two?'Thời gian sân bay 2':'Thời gian 2 (cùng sân bay 1)'};document.getElementById('compareButton').onclick=render;fetch(dataUrl).then(function(r){return r.json()}).then(function(d){flights=d.flights||[];fill();document.getElementById('airportCount').dispatchEvent(new Event('change'))}).catch(function(e){document.getElementById('airportResult').innerHTML='<div class="airport-error">Không thể tải dữ liệu: '+esc(e.message)+'</div>'});})();
</script>
</asp:Content>
