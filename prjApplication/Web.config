<?xml version="1.0"?>
<configuration>
  <configSections>
    <!-- Initialize the HPC Configuration Handler  -->
    <sectionGroup name="HPC">
      <section name="infor" type="HPCShareDLL.ConfigurationHandler, HPCShareDLL"/>
    </sectionGroup>
  </configSections>
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.5" />
      </system.Web>
  -->
  <system.web>
    <authorization>
      <deny users="?"/>
    </authorization>
    <pages validateRequest="false" controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID"/>
    <customErrors mode="Off" defaultRedirect="Errors/ErrorPage.htm"/>
    <!-- 
            Set compilation debug="true" to insert debugging 
            symbols into the compiled page. Because this 
            affects performance, set this value to true only 
            during development.
        -->
    <compilation debug="true" defaultLanguage="c#" targetFramework="4.8">
      <assemblies>
        <add assembly="System.Windows.Forms, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
        <add assembly="System.Design, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
        <add assembly="System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
        <add assembly="System.Web.Extensions.Design, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>
        <add assembly="System.Web, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
        <add assembly="System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
        <add assembly="System.Configuration, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
        <add assembly="System.Drawing, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
        <add assembly="System.Xml, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
        <add assembly="System.Data, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089"/>
        <add assembly="System.Web.Services, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
        <add assembly="System.DirectoryServices, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
        <add assembly="System.DirectoryServices.Protocols, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
        <add assembly="System.EnterpriseServices, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
        <add assembly="System.ServiceProcess, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
        <add assembly="System.Web.RegularExpressions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A"/>
      </assemblies>
    </compilation>
    <httpRuntime executionTimeout="1000000" maxRequestLength="2097151"/>
    <httpHandlers>
      <add verb="*" path="BusyBoxDotNet.axd" type="BusyBoxDotNet.ResourceHttpHandler, BusyBoxDotNet"/>
    </httpHandlers>
    <!--
            The <authentication> section enables configuration 
            of the security authentication mode used by 
            ASP.NET to identify an incoming user. 
        -->
    <httpModules>
      <add name="prjComponents" type="prjComponents.HttpHandler, prjComponents"/>
      <!-- BEGIN: Microsoft ASP.NET AJAX -->
      <!-- END: Microsoft ASP.NET AJAX -->
      <!--<add name="ScriptModule" type="System.Web.Handlers.ScriptModule, System.Web.Extensions, Version=3.5.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35"/>-->
    </httpModules>
    <membership defaultProvider="FlashUploadProvider">
      <providers>
        <add name="FlashUploadProvider" type="CustomMembership"/>
      </providers>
    </membership>
    <authentication mode="Forms"/>
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8"/>
    <!--
            The <customErrors> section enables configuration 
            of what to do if/when an unhandled error occurs 
            during the execution of a request. Specifically, 
            it enables developers to configure html error pages 
            to be displayed in place of a error stack trace.

        <customErrors mode="RemoteOnly" defaultRedirect="GenericErrorPage.htm">
            <error statusCode="403" redirect="NoAccess.htm" />
            <error statusCode="404" redirect="FileNotFound.htm" />
        </customErrors>
        -->
  </system.web>
  <location path="UploadMulti/Upload.ashx">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="UploadMulti/UploadAds.ashx">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="Products/UploadProducts.ashx">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="Article/Handler.ashx">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="Albums/UploadImgMulti.ashx">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="Until/UploadImg.ashx">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="UploadVideos/UploadVideos.ashx">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="UploadVideos/UploadQcao.ashx">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>
  <location path="Khoanh/UploadToStock.ashx">
    <system.web>
      <authorization>
        <allow users="*"/>
      </authorization>
    </system.web>
  </location>
  <system.webServer>
    <!-- Nen noi dung tinh va cho phep trinh duyet cache tai nguyen tinh trong 30 ngay. -->
    <urlCompression doStaticCompression="true"/>
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00"/>
    </staticContent>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="2000000000"/>
      </requestFiltering>
    </security>
    <validation validateIntegratedModeConfiguration="false"/>
    <defaultDocument>
      <files>
        <clear/>
        <add value="default.aspx"/>
        <add value="Default.htm"/>
        <add value="Default.asp"/>
        <add value="index.htm"/>
        <add value="index.html"/>
        <add value="iisstart.htm"/>
      </files>
    </defaultDocument>
  </system.webServer>
  <location allowOverride="true" inheritInChildApplications="true">
    <appSettings>
      <add key="ServerPathDis" value="C:\ATFM\Upload"/>
      <add key="Path_Replate" value="http://localhost"/>
      <add key="UploadPath" value="/imagesbidv/"/>
      <!--Folder upload gallary-->
      <add key="UploadPhotoAlbum" value="UploadPhotoAlbum"/>
      <!--Default Combobox-->
      <add key="DefaultCombobox" value="1"/>
      <!--END-->
      <!--Default VNPResizeImages-->
      <add key="VNPResizeImages" value="665"/>
      <!--END-->
      <!--Default Rezie In Content-->
      <add key="VNPResizeContent" value="490"/>
      <!--END-->
      <!--Folder upload galary event-->
      <add key="UploadPhotoEvent" value="PhotoEvent"/>
      <!--END-->
      <add key="DefaultLangID" value="2"/>
      <add key="DefaultSourceRss" value="3"/>
      <add key="HPCOnmouseoverGrid" value="#B9E0E9"/>
      <add key="HPCOnmouseoverOut" value="white"/>
      <add key="DataDynamicsARLic" value="CHANGE_ME"/>
      <add key="MembersPerPage" value="15"/>
      <add key="PortalID" value="1"/>
      <add key="defaultLanguage" value="vi-VN"/>
      <add key="ApplicationPath" value="http://localhost/atfm_web"/>
      <add key="applicationpath.api" value="http://localhost/QLB.API/"/>
      <add key="OracleConnectionString" value="Data Source=localhost/ATFM;User Id=CHANGE_ME;Password=CHANGE_ME;"/>
      <!-- Thay bang URL API cua moi truong; khong commit endpoint production. -->
      <add key="tinpath" value="http://localhost/"/>
      <add key="ATMPATH" value="http://localhost/upload/ShareATM/"/>
      <add key="FileUploadPathMB" value="c:\\upload\\ShareATM\\MB\\"/>
      <add key="FileUploadPathMN" value="c:\\upload\\ShareATM\\MN\\"/>
      <add key="FileUploadPathMT" value="c:\\upload\\ShareATM\\MT\\"/>
      <add key="tinpathFTP" value="ftp://localhost/"/>
      <add key="configFile" value="~/App_Data/PortalSettings.xml"/>
      <add key="MailCategory" value="20"/>
      <!--BEGIN MAIL-->
      <add key="Smtp_Server" value="smtp.gmail.com"/>
      <add key="Smtp_Server_port" value="25"/>
      <add key="Smtp_Server_RequireAuthen" value="true"/>
      <add key="WatermarkImages" value="0"/>
      <add key="SpaceValue" value="10"/>
      <add key="AutoProcessReszie" value="1"/>
      <add key="TagHtmlNotRemove" value="img|p|br|sup|sub|a|i|b|em|div"/>
      <add key="ApplicationName" value="CMSSANNONGSAN"/>
      <!--value:1 Đóng dấu và Resize ảnh;value:0 Resize ảnh Không đóng dấu;-->
      <!--Download Ảnh px-->
      <add key="Min_With" value="100"/>
      <add key="Min_height" value="100"/>
      <!--Report gia Tri 1: Dùng Fix: 0 Không dùng-->
      <add key="ReportFix" value="1"/>
      <!---End Cache-->
      <add key="MultimediaPath" value="http://localhost/atfm"/>
      <!--FTP HOST UPLOAD-Gia Tri 1: Dùng FTP: 0 Không dùng FTP-->
      <add key="UseUpload_FTP" value="0"/>
      <add key="FTP_NameServer" value="ftp://localhost/"/>
      <add key="Username_FTP" value="CHANGE_ME"/>
      <add key="Password_FTP" value="CHANGE_ME"/>
      <!--BEGIN UPLOAD-->
      <!--BEGIN REPORT-->
      <add key="CompanyName" value="TỔNG CÔNG TY QUẢN LÝ BAY VIỆT NAM"/>
      <add key="CenterName" value="TRUNG TÂM QUẢN LÝ LUỒNG KHÔNG LƯU"/>
    </appSettings>
  </location>
  <HPC>
    <infor defaultProvider="HPCDataProvider" defaultFtp="FtpInfor" defaultLanguage="vi" defaultSkin="default" filesPath="/" message="~/Msgs/default.aspx?MessageID={0}" title="HỆ THỐNG QUẢN TRỊ WEBSITE" pagesize="10" path_IP="http://localhost" uploadPath="/Upload" pathfileupload="/Upload" pathfilemanager="C:\ATFM\Upload" address_documents="http://localhost" data_documents="server=localhost;database=ATFM;uid=CHANGE_ME;pwd=CHANGE_ME;App=HPC">
      <providers>
        <clear/>
        <add name="HPCDataProvider" type="HPCServerDataAccess.BaseClass, HPCServerDataAccess" connectionString="server=localhost;database=ATFM;uid=CHANGE_ME;pwd=CHANGE_ME;App=HPC" databaseOwner="dbo" commandTimeout="1200"/>
      </providers>
      <ftp>
        <clear/>
        <add name="FtpInfor" address="localhost" user="CHANGE_ME" pass="CHANGE_ME" forder="ATFM" port="21"/>
      </ftp>
    </infor>
  </HPC>
  <system.net>
    <mailSettings>
      <smtp>
        <network host="localhost" port="25" userName="CHANGE_ME" password="CHANGE_ME" defaultCredentials="false"/>
      </smtp>
    </mailSettings>
  </system.net>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="office" publicKeyToken="71E9BCE111E9429C" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-12.0.0.0" newVersion="12.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.Vbe.Interop" publicKeyToken="71E9BCE111E9429C" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-12.0.0.0" newVersion="12.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0"/>
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="HtmlAgilityPack" publicKeyToken="bd319b19eaf3b43a" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-1.4.6.0" newVersion="1.4.6.0"/>
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
