<script src="<%=Global.ApplicationPath%>/Style/assets/js/jquery-1.11.3.min.js"></script>
<![endif]-->
        <script type="text/javascript">
            if ('ontouchstart' in document.documentElement) document.write("<script src='<%=Global.ApplicationPath%>/Style/assets/js/jquery.mobile.custom.min.js'>" + "<" + "/script>");
