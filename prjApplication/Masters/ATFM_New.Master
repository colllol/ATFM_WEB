        <!-- inline scripts related to this page -->
        <script type="text/javascript">
            function btnSend_Onclick() {
                var obj = {
                    P_OT_CONT: $('#txtContent').val()
                };
                GetArgWithPostBack(JSON.stringify(obj) + phanCachArg + 'btnSend_Onclick', 'btnSend_Onclick');
            }

            jQuery(function ($) {
                var $sidebar = $('.sidebar').eq(0);
                if (!$sidebar.hasClass('h-sidebar')) return;
                try {
                    $(document).on('settings.ace.top_menu', function (ev, event_name, fixed) {
                        if (event_name !== 'sidebar_fixed') return;

                        var sidebar = $sidebar.get(0);
                        var $window = $(window);

                        //return if sidebar is not fixed or in mobile view mode
                        var sidebar_vars = $sidebar.ace_sidebar('vars');
                        if (!fixed || (sidebar_vars['mobile_view'] || sidebar_vars['collapsible'])) {
                            $sidebar.removeClass('lower-highlight');
                            //restore original, default marginTop
                            sidebar.style.marginTop = '';

                            $window.off('scroll.ace.top_menu')
                            return;
                        }


                        var done = false;
                        $window.on('scroll.ace.top_menu', function (e) {

                            var scroll = $window.scrollTop();
                            scroll = parseInt(scroll / 4);//move the menu up 1px for every 4px of document scrolling
                            if (scroll > 17) scroll = 17;


                            if (scroll > 16) {
                                if (!done) {
                                    $sidebar.addClass('lower-highlight');
                                    done = true;
                                }
                            }
                            else {
                                if (done) {
                                    $sidebar.removeClass('lower-highlight');
                                    done = false;
                                }
                            }

                            sidebar.style['marginTop'] = (17 - scroll) + 'px';
                        }).triggerHandler('scroll.ace.top_menu');

                    }).triggerHandler('settings.ace.top_menu', ['sidebar_fixed', $sidebar.hasClass('sidebar-fixed')]);

                    $(window).on('resize.ace.top_menu', function () {
                        $(document).triggerHandler('settings.ace.top_menu', ['sidebar_fixed', $sidebar.hasClass('sidebar-fixed')]);
                    });
                } catch (e) {

                }



            });
        </script>
        <script type="text/javascript">
            (function () {
                function directChildByClass(element, className) {
                    for (var i = 0; i < element.children.length; i++) {
                        if ((' ' + element.children[i].className + ' ').indexOf(' ' + className + ' ') >= 0) {
                            return element.children[i];
                        }
                    }
                    return null;
                }

                function closeMenuPanels(menu) {
                    var items = menu.children;
                    for (var i = 0; i < items.length; i++) {
                        items[i].classList.remove('atfm-panel-active');
                        items[i].classList.remove('open');
                        var submenu = directChildByClass(items[i], 'submenu');
                        if (submenu) submenu.classList.remove('atfm-submenu-visible');
                    }
                    menu.classList.remove('atfm-has-open-panel');
                }

                function initializeVerticalMenu() {
                    var menu = document.querySelector('#sidebar .atfm-menu-list');
                    if (!menu || menu.getAttribute('data-atfm-ready') === '1') return;
                    menu.setAttribute('data-atfm-ready', '1');

                    var workspace = document.querySelector('#main-container > .atfm-workspace');
                    var toggleButton = document.querySelector('#sidebar .atfm-sidebar-toggle');

                    function fitSidebarToMenuText() {
                        if (!workspace || window.innerWidth < 992) return;
                        var widest = 0;
                        for (var i = 0; i < menu.children.length; i++) {
                            var link = directChildByClass(menu.children[i], 'dropdown-toggle') || menu.children[i].querySelector('a');
                            var textNode = link ? link.querySelector('.menu-text') : null;
                            if (textNode) widest = Math.max(widest, textNode.scrollWidth);
                        }
                        // Phần dư dành cho icon, arrow và padding hai bên.
                        var fittedWidth = Math.max(300, Math.min(440, widest + 105));
                        workspace.style.setProperty('--atfm-sidebar-width', fittedWidth + 'px');
                    }

                    var sidebarWidthReady = false;
                    var transitionTimer = null;

                    function ensureSidebarWidth() {
                        if (sidebarWidthReady) return;
                        fitSidebarToMenuText();
                        sidebarWidthReady = true;
                    }

                    function setSidebarCollapsed(collapsed, saveState) {
                        if (!workspace || !toggleButton) return;
                        if (collapsed) closeMenuPanels(menu);
                        else ensureSidebarWidth();

                        workspace.classList.add('atfm-sidebar-transitioning');
                        workspace.classList.toggle('atfm-sidebar-collapsed', collapsed);
                        toggleButton.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
                        toggleButton.setAttribute('aria-label', collapsed ? 'Mở rộng menu' : 'Thu gọn menu');
                        toggleButton.setAttribute('title', collapsed ? 'Mở rộng menu' : 'Thu gọn menu');

                        window.clearTimeout(transitionTimer);
                        transitionTimer = window.setTimeout(function () {
                            workspace.classList.remove('atfm-sidebar-transitioning');
                        }, 240);

                        if (saveState) {
                            try {
                                window.localStorage.setItem('atfm-sidebar-collapsed', collapsed ? '1' : '0');
                            } catch (e) { }
                        }
                    }

                    if (toggleButton) {
                        /* Mỗi lần tải trang luôn bắt đầu ở trạng thái thu gọn. */
                        setSidebarCollapsed(true, false);
                        try { window.localStorage.setItem('atfm-sidebar-collapsed', '1'); } catch (e) { }

                        toggleButton.addEventListener('click', function (event) {
                            event.preventDefault();
                            event.stopPropagation();
                            if (event.stopImmediatePropagation) event.stopImmediatePropagation();
                            setSidebarCollapsed(!workspace.classList.contains('atfm-sidebar-collapsed'), true);
                        }, true);
                    }

                    menu.addEventListener('click', function (event) {
                        var link = event.target;
                        while (link && link.tagName !== 'A') link = link.parentNode;
                        if (!link) return;

                        var parentList = link.parentNode ? link.parentNode.parentNode : null;
                        var isSubmenuLink = parentList && (' ' + parentList.className + ' ').indexOf(' submenu ') >= 0;

                        if (isSubmenuLink) {
                            var targetUrl = link.getAttribute('href');
                            if (!targetUrl || targetUrl === '#') return;

                            event.preventDefault();
                            event.stopPropagation();
                            if (event.stopImmediatePropagation) event.stopImmediatePropagation();
                            setSidebarCollapsed(true, true);
                            window.location.assign(targetUrl);
                            return;
                        }

                        if (!parentList || parentList !== menu) return;

                        var item = link.parentNode;
                        var submenu = directChildByClass(item, 'submenu');
                        if (!submenu) return;

                        event.preventDefault();
                        event.stopPropagation();
                        if (event.stopImmediatePropagation) event.stopImmediatePropagation();

                        if (workspace && workspace.classList.contains('atfm-sidebar-collapsed')) {
                            setSidebarCollapsed(false, true);
                        }

                        var isOpen = submenu.classList.contains('atfm-submenu-visible');
                        closeMenuPanels(menu);
                        var title = link.querySelector('.menu-text');
                        submenu.setAttribute('data-menu-title', title ? title.textContent.trim() : 'Danh sách chức năng');

                        var submenuItemCount = submenu.children.length;
                        var submenuColumns = submenuItemCount === 4 ? 2 : Math.min(Math.max(submenuItemCount, 1), 3);
                        var submenuWidth = (submenuColumns * 292) + ((submenuColumns - 1) * 12) + 40;
                        submenu.style.setProperty('--atfm-submenu-columns', submenuColumns);
                        submenu.style.setProperty('--atfm-submenu-width', submenuWidth + 'px');

                        if (!isOpen) {
                            item.classList.add('atfm-panel-active');
                            submenu.classList.add('atfm-submenu-visible');
                            menu.classList.add('atfm-has-open-panel');
                        }
                    }, true);

                    document.addEventListener('keydown', function (event) {
                        if (event.key === 'Escape' || event.keyCode === 27) closeMenuPanels(menu, null);
                    });

                    document.addEventListener('click', function (event) {
                        if (!document.querySelector('#sidebar .submenu.atfm-submenu-visible')) return;
                        if (!document.getElementById('sidebar').contains(event.target)) closeMenuPanels(menu);
                    });
                }

                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', initializeVerticalMenu);
                } else {
                    initializeVerticalMenu();
                }
            })();
        </script>
        <script type="text/javascript">
            (function () {
                var NOTIFICATION_API_URL = '<%= ResolveUrl("~/Handlers/Notification.ashx") %>';
                var notificationRequestInFlight = false;
                var notificationReloadPending = false;
                var notificationsLoadedOnce = false;
                var currentUnreadCount = 0;

                function closeHeaderPopups(except) {
                    var actions = document.querySelectorAll('#navbar .atfm-header-action');
                    for (var i = 0; i < actions.length; i++) {
                        if (actions[i] !== except) actions[i].classList.remove('is-open');
                        var button = actions[i].querySelector('.atfm-popup-toggle');
                        if (button && actions[i] !== except) button.setAttribute('aria-expanded', 'false');
                    }
                }

                function parseNotificationDate(value) {
                    if (!value) return null;
                    var match = /\/Date\((\d+)/.exec(value);
                    var date = match ? new Date(parseInt(match[1], 10)) : new Date(value);
                    return isNaN(date.getTime()) ? null : date;
                }

                function formatNotificationDate(value) {
                    var date = parseNotificationDate(value);
                    if (!date) return '';
                    var pad = function (number) { return number < 10 ? '0' + number : String(number); };
                    return pad(date.getDate()) + '/' + pad(date.getMonth() + 1) + '/' + date.getFullYear()
                        + ' ' + pad(date.getHours()) + ':' + pad(date.getMinutes()) + ':' + pad(date.getSeconds());
                }

                function setUnreadCount(value) {
                    var badge = document.getElementById('atfmNotificationBadge');
                    var markRead = document.getElementById('atfmMarkAllRead');
                    currentUnreadCount = Math.max(0, parseInt(value, 10) || 0);
                    if (badge) {
                        badge.textContent = currentUnreadCount > 99 ? '99+' : String(currentUnreadCount);
                        badge.classList.toggle('is-empty', currentUnreadCount === 0);
                        badge.setAttribute('aria-label', currentUnreadCount + ' thông báo chưa đọc');
                    }
                    if (markRead) markRead.disabled = currentUnreadCount === 0;
                }

                function appendNotificationText(parent, className, value) {
                    var element = document.createElement('span');
                    element.className = className;
                    element.textContent = value == null ? '' : String(value);
                    parent.appendChild(element);
                }

                function renderEmptyNotification(list) {
                    var empty = document.createElement('div');
                    empty.className = 'atfm-empty-notification';
                    empty.textContent = 'Chưa có thông báo chưa đọc';
                    list.appendChild(empty);
                }

                function animateNotificationRemoval(elements, callback) {
                    elements = Array.prototype.slice.call(elements || []);
                    if (!elements.length) {
                        if (callback) callback();
                        return;
                    }

                    for (var i = 0; i < elements.length; i++) {
                        elements[i].style.maxHeight = elements[i].offsetHeight + 'px';
                    }
                    window.setTimeout(function () {
                        for (var j = 0; j < elements.length; j++) elements[j].classList.add('is-removing');
                    }, 10);
                    window.setTimeout(function () {
                        for (var k = 0; k < elements.length; k++) {
                            if (elements[k].parentNode) elements[k].parentNode.removeChild(elements[k]);
                        }
                        if (callback) callback();
                    }, 280);
                }

                function renderNotifications(items, unreadCount) {
                    var list = document.getElementById('atfmNotificationList');
                    if (!list) return;

                    items = Object.prototype.toString.call(items) === '[object Array]' ? items : [];
                    while (list.firstChild) list.removeChild(list.firstChild);
                    for (var i = 0; i < items.length && i < 50; i++) {
                        var item = items[i] || {};
                        var entry = document.createElement('div');
                        entry.className = 'atfm-notification-item is-unread';
                        entry.setAttribute('data-notification-id', item.ID);
                        var copy = document.createElement('div');
                        copy.className = 'atfm-notification-copy';
                        appendNotificationText(copy, 'atfm-notification-title', item.TITLE || 'Thông báo');
                        appendNotificationText(copy, 'atfm-notification-message', item.CONTENT || '');
                        appendNotificationText(copy, 'atfm-notification-time', formatNotificationDate(item.DATETIME));
                        entry.appendChild(copy);
                        var readButton = document.createElement('button');
                        readButton.type = 'button';
                        readButton.className = 'atfm-notification-read-one';
                        readButton.setAttribute('data-notification-id', item.ID);
                        readButton.setAttribute('title', 'Đánh dấu đã đọc');
                        readButton.innerHTML = '<i class="fa fa-check" aria-hidden="true"></i><span>Đọc</span>';
                        entry.appendChild(readButton);
                        list.appendChild(entry);
                    }

                    if (!items.length) {
                        renderEmptyNotification(list);
                    }
                    setUnreadCount(unreadCount);
                }

                function sendNotificationRequest(options) {
                    options = $.extend({}, options, {
                        global: false,
                        xhr: function () {
                            var xhr = $.ajaxSettings.xhr();
                            xhr.atfmSuppressLoading = true;
                            return xhr;
                        }
                    });
                    return $.ajax(options);
                }

                function loadNotifications(force) {
                    if (notificationRequestInFlight) {
                        notificationReloadPending = true;
                        return;
                    }
                    if (!force && document.hidden) return;
                    notificationRequestInFlight = true;
                    sendNotificationRequest({
                        type: 'GET',
                        url: NOTIFICATION_API_URL,
                        cache: false,
                        dataType: 'json'
                    }).done(function (response) {
                        if (!response || response.Code !== '00') return;
                        notificationsLoadedOnce = true;
                        renderNotifications(response.ListValue || [], response.Value);
                    }).fail(function () {
                        if (!notificationsLoadedOnce) {
                            var list = document.getElementById('atfmNotificationList');
                            if (list) list.textContent = 'Không thể tải thông báo.';
                        }
                    }).always(function () {
                        notificationRequestInFlight = false;
                        if (notificationReloadPending) {
                            notificationReloadPending = false;
                            loadNotifications(true);
                        }
                    });
                }

                function initializeHeaderPopups() {
                    var actions = document.querySelectorAll('#navbar .atfm-header-action');
                    for (var i = 0; i < actions.length; i++) {
                        (function (action) {
                            var toggle = action.querySelector('.atfm-popup-toggle');
                            if (!toggle) return;
                            toggle.addEventListener('click', function (event) {
                                event.preventDefault();
                                event.stopPropagation();
                                var willOpen = !action.classList.contains('is-open');
                                closeHeaderPopups(action);
                                action.classList.toggle('is-open', willOpen);
                                toggle.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
                                if (willOpen && action.id === 'atfmNotification') loadNotifications(true);
                            });
                        })(actions[i]);
                    }

                    var popupName = document.getElementById('atfmUserNamePopup');
                    var headerName = document.querySelector('#atfmUserMenu .user-info');
                    if (popupName && headerName) {
                        var small = headerName.querySelector('small');
                        popupName.textContent = headerName.textContent.replace(small ? small.textContent : '', '').replace(/^\s+|\s+$/g, '');
                    }

                    var markRead = document.getElementById('atfmMarkAllRead');
                    var notificationList = document.getElementById('atfmNotificationList');
                    if (notificationList) notificationList.addEventListener('click', function (event) {
                        var button = event.target;
                        while (button && button !== notificationList && !button.classList.contains('atfm-notification-read-one')) {
                            button = button.parentNode;
                        }
                        if (!button || button === notificationList || button.disabled) return;

                        event.preventDefault();
                        event.stopPropagation();
                        var id = parseInt(button.getAttribute('data-notification-id'), 10);
                        if (!id) return;
                        button.disabled = true;
                        sendNotificationRequest({
                            type: 'POST',
                            url: NOTIFICATION_API_URL + '?action=markRead&id=' + encodeURIComponent(id),
                            dataType: 'json',
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        }).done(function (response) {
                            if (!response || response.Code !== '00') {
                                button.disabled = false;
                                return;
                            }
                            setUnreadCount(Math.max(0, currentUnreadCount - 1));
                            var entry = button.parentNode;
                            animateNotificationRemoval([entry], function () {
                                if (!notificationList.querySelector('.atfm-notification-item')) {
                                    renderEmptyNotification(notificationList);
                                }
                                loadNotifications(true);
                            });
                        }).fail(function () {
                            button.disabled = false;
                        });
                    });

                    if (markRead) markRead.addEventListener('click', function (event) {
                        event.preventDefault();
                        event.stopPropagation();
                        if (markRead.disabled || currentUnreadCount === 0) return;
                        markRead.disabled = true;
                        sendNotificationRequest({
                            type: 'POST',
                            url: NOTIFICATION_API_URL + '?action=markAllRead',
                            dataType: 'json',
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        }).done(function (response) {
                            if (response && response.Code === '00') {
                                setUnreadCount(0);
                                var unreadItems = document.querySelectorAll('#atfmNotificationList .atfm-notification-item');
                                animateNotificationRemoval(unreadItems, function () {
                                    renderNotifications([], 0);
                                    loadNotifications(true);
                                });
                            }
                        }).fail(function () {
                            loadNotifications(true);
                        }).always(function () {
                            markRead.disabled = currentUnreadCount === 0;
                        });
                    });

                    document.addEventListener('click', function () { closeHeaderPopups(null); });
                    document.addEventListener('keydown', function (event) {
                        if (event.key === 'Escape' || event.keyCode === 27) closeHeaderPopups(null);
                    });
                    document.addEventListener('atfm:notifications-changed', function () { loadNotifications(true); });
                    loadNotifications(true);
                    window.setInterval(function () { loadNotifications(false); }, 30000);
                }

                if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initializeHeaderPopups);
                else initializeHeaderPopups();
            })();
        </script>
        <style type="text/css">
            .atfm-loading-overlay {
                position: fixed;
                z-index: 999999;
                inset: 0;
                display: flex;
                visibility: hidden;
                align-items: center;
                justify-content: center;
                background: rgba(235, 243, 249, .72);
                opacity: 0;
                pointer-events: none;
                -webkit-backdrop-filter: blur(3px);
                backdrop-filter: blur(3px);
                transition: opacity .18s ease, visibility .18s ease;
            }
            .atfm-loading-overlay.is-visible { visibility: visible; opacity: 1; pointer-events: all; }
            .atfm-loading-box { min-width: 150px; padding: 22px 28px; border: 1px solid rgba(51, 122, 183, .18); border-radius: 14px; background: rgba(255, 255, 255, .94); text-align: center; box-shadow: 0 15px 40px rgba(31, 65, 92, .18); }
            .atfm-loading-spinner { position: relative; width: 48px; height: 48px; margin: 0 auto 13px; }
            .atfm-loading-spinner:before, .atfm-loading-spinner:after { content: ""; position: absolute; inset: 0; border-radius: 50%; border: 4px solid transparent; }
            .atfm-loading-spinner:before { border-top-color: #337ab7; border-right-color: #337ab7; animation: atfmLoadingSpin .8s linear infinite; }
            .atfm-loading-spinner:after { inset: 8px; border-bottom-color: #20b486; border-left-color: #20b486; animation: atfmLoadingSpinReverse .65s linear infinite; }
            .atfm-loading-text { color: #31536e; font-size: 13px; font-weight: 700; letter-spacing: .2px; }
            @keyframes atfmLoadingSpin { to { transform: rotate(360deg); } }
            @keyframes atfmLoadingSpinReverse { to { transform: rotate(-360deg); } }
            @media (prefers-reduced-motion: reduce) { .atfm-loading-spinner:before, .atfm-loading-spinner:after { animation-duration: 1.8s; } }
        </style>
        <div id="atfmGlobalLoading" class="atfm-loading-overlay" role="status" aria-live="polite" aria-hidden="true">
            <div class="atfm-loading-box"><div class="atfm-loading-spinner"></div><div id="atfmLoadingText" class="atfm-loading-text">Đang tải dữ liệu...</div></div>
        </div>
        <script type="text/javascript">
            (function () {
                var overlay = document.getElementById('atfmGlobalLoading');
                var textNode = document.getElementById('atfmLoadingText');
                var pendingTasks = 0;
                var safetyTimer = null;
                var exportDownloadPending = false;
                var exportFallbackTimer = null;
                var suppressDateLoadingUntil = 0;

                function isDateFilterControl(control) {
                    if (!control || control.nodeType !== 1) return false;
                    var type = String(control.type || '').toLowerCase();
                    if (control.tagName === 'INPUT' && /^(date|datetime-local|month|week)$/.test(type)) return true;
                    var identity = [control.id, control.name, control.className,
                        control.getAttribute && control.getAttribute('placeholder'),
                        control.getAttribute && control.getAttribute('aria-label')].join(' ').toLowerCase();
                    return control.tagName === 'INPUT' && /(datepicker|date-picker|flightdate|fromdate|todate|ngay|ngày)/.test(identity);
                }

                function suppressDateLoading() {
                    suppressDateLoadingUntil = Date.now() + 350;
                }

                function shouldSuppressLoading() {
                    return Date.now() <= suppressDateLoadingUntil;
                }

                // Chọn ngày chỉ thay đổi điều kiện lọc; không khóa toàn trang bằng overlay.
                document.addEventListener('input', function (event) {
                    if (isDateFilterControl(event.target)) suppressDateLoading();
                    else suppressDateLoadingUntil = 0;
                }, true);
                document.addEventListener('change', function (event) {
                    if (isDateFilterControl(event.target)) suppressDateLoading();
                    else suppressDateLoadingUntil = 0;
                }, true);
                // Một nút thao tác thực sự (Search/Áp dụng/Lưu...) luôn được phép hiển thị loading.
                document.addEventListener('click', function (event) {
                    var action = event.target && event.target.closest ? event.target.closest('button,input[type="button"],input[type="submit"],a') : null;
                    if (action && !isDateFilterControl(action)) suppressDateLoadingUntil = 0;
                }, true);

                function showLoading(message) {
                    pendingTasks++;
                    if (message && textNode) textNode.textContent = message;
                    overlay.classList.add('is-visible');
                    overlay.setAttribute('aria-hidden', 'false');
                    clearTimeout(safetyTimer);
                    safetyTimer = setTimeout(function () { pendingTasks = 0; hideLoading(true); }, 60000);
                }

                function hideLoading(force) {
                    pendingTasks = force ? 0 : Math.max(0, pendingTasks - 1);
                    if (pendingTasks > 0) return;
                    clearTimeout(safetyTimer);
                    overlay.classList.remove('is-visible');
                    overlay.setAttribute('aria-hidden', 'true');
                    if (textNode) textNode.textContent = 'Đang tải dữ liệu...';
                }

                window.ATFMLoading = { show: showLoading, hide: function () { hideLoading(false); }, forceHide: function () { hideLoading(true); } };
                window.addEventListener('load', function () { hideLoading(true); });
                window.addEventListener('pageshow', function () { hideLoading(true); });
                window.addEventListener('beforeunload', function () {
                    if (!shouldSuppressLoading()) showLoading('Đang chuyển trang...');
                });

                function isExportAction(id, text) {
                    return /export|excel|xuất/i.test((id || '') + ' ' + (text || ''));
                }

                function beginExportDownload() {
                    exportDownloadPending = true;
                    showLoading('Đang chuẩn bị file...');
                    clearTimeout(exportFallbackTimer);
                    exportFallbackTimer = setTimeout(function () { exportDownloadPending = false; hideLoading(true); }, 30000);
                }

                window.addEventListener('blur', function () {
                    if (!exportDownloadPending) return;
                    exportDownloadPending = false;
                    clearTimeout(exportFallbackTimer);
                    hideLoading(true);
                });

                document.addEventListener('submit', function (event) {
                    if (shouldSuppressLoading()) return;
                    var submitter = event.submitter;
                    if (submitter && isExportAction(submitter.id || submitter.name, submitter.value || submitter.textContent)) beginExportDownload();
                    else showLoading('Đang xử lý yêu cầu...');
                }, true);
                document.addEventListener('click', function (event) {
                    if (event.defaultPrevented || event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
                    var link = event.target;
                    while (link && link.tagName !== 'A') link = link.parentNode;
                    if (!link || link.hasAttribute('download') || link.getAttribute('target') === '_blank') return;
                    var href = link.getAttribute('href');
                    if (!href || /^javascript:/i.test(href)) return;
                    if (href === '#') return;
                    showLoading('Đang chuyển trang...');
                }, true);

                if (window.jQuery) {
                    window.jQuery(document).ajaxStart(function () {
                        if (!shouldSuppressLoading()) showLoading('Đang tải dữ liệu...');
                    });
                    window.jQuery(document).ajaxStop(function () { hideLoading(true); });
                }

                if (window.fetch) {
                    var originalFetch = window.fetch;
                    window.fetch = function () {
                        var options = arguments.length > 1 ? arguments[1] : null;
                        if ((options && options.atfmSilent === true) || shouldSuppressLoading()) return originalFetch.apply(this, arguments);
                        showLoading('Đang tải dữ liệu...');
                        return originalFetch.apply(this, arguments).then(function (response) { hideLoading(true); return response; }, function (error) { hideLoading(true); throw error; });
                    };
                }

                // Bao phủ các lời gọi XMLHttpRequest thuần không đi qua jQuery.
                if (window.XMLHttpRequest && window.XMLHttpRequest.prototype) {
                    var originalXhrSend = window.XMLHttpRequest.prototype.send;
                    window.XMLHttpRequest.prototype.send = function () {
                        if (this.atfmSuppressLoading === true || shouldSuppressLoading()) return originalXhrSend.apply(this, arguments);
                        showLoading('Đang tải dữ liệu...');
                        var xhr = this;
                        var finishLoading = function () { xhr.removeEventListener('loadend', finishLoading, false); hideLoading(true); };
                        this.addEventListener('loadend', finishLoading, false);
                        try { return originalXhrSend.apply(this, arguments); }
                        catch (error) { hideLoading(true); throw error; }
                    };
                }

                // ASP.NET Web Forms: postback có thể gọi form.submit() trực tiếp nên không phát sinh DOM submit event.
                if (window.HTMLFormElement && window.HTMLFormElement.prototype && window.HTMLFormElement.prototype.submit) {
                    var originalFormSubmit = window.HTMLFormElement.prototype.submit;
                    window.HTMLFormElement.prototype.submit = function () {
                        if (!shouldSuppressLoading()) showLoading('Đang xử lý yêu cầu...');
                        return originalFormSubmit.apply(this, arguments);
                    };
                }

                function hookWebFormsLoading() {
                    if (typeof window.__doPostBack === 'function' && !window.__doPostBack.atfmLoadingHooked) {
                        var originalDoPostBack = window.__doPostBack;
                        var wrappedDoPostBack = function (eventTarget) {
                            var controlId = (eventTarget || '').replace(/\$/g, '_');
                            var control = controlId ? document.getElementById(controlId) : null;
                            if (isDateFilterControl(control) || shouldSuppressLoading()) return originalDoPostBack.apply(this, arguments);
                            if (isExportAction(eventTarget, control ? (control.value || control.textContent) : '')) beginExportDownload();
                            else showLoading('Đang xử lý yêu cầu...');
                            return originalDoPostBack.apply(this, arguments);
                        };
                        wrappedDoPostBack.atfmLoadingHooked = true;
                        window.__doPostBack = wrappedDoPostBack;
                    }
                    if (window.Sys && window.Sys.WebForms && window.Sys.WebForms.PageRequestManager) {
                        var manager = window.Sys.WebForms.PageRequestManager.getInstance();
                        if (manager && !manager._atfmLoadingHooked) {
                            manager.add_beginRequest(function (sender, args) {
                                var source = args && args.get_postBackElement ? args.get_postBackElement() : null;
                                manager._atfmDateRequest = isDateFilterControl(source) || shouldSuppressLoading();
                                if (!manager._atfmDateRequest) showLoading('Đang xử lý yêu cầu...');
                            });
                            manager.add_endRequest(function () {
                                if (!manager._atfmDateRequest) hideLoading(true);
                                manager._atfmDateRequest = false;
                            });
                            manager._atfmLoadingHooked = true;
                        }
                    }
                }
                if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', hookWebFormsLoading);
                else hookWebFormsLoading();
                window.addEventListener('load', hookWebFormsLoading);
            })();
        </script>
        <script src="<%=Global.ApplicationPath%>/Scripts/ResponsiveTable.js"></script>
    </form>
</body>
</html>

