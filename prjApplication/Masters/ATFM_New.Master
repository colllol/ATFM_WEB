<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="ATFM.Master.cs" Inherits="prjApplication.Masters.ATFM" %>

<%@ Register Assembly="AjaxControlToolkit" Namespace="AjaxControlToolkit" TagPrefix="cc2" %>
<%@ Register Assembly="prjComponents" Namespace="prjComponents" TagPrefix="cc1" %>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta http-equiv="REFRESH" content="5400" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="robots" content="noindex, nofollow" />
    <script>window.reportApiBase = ('<%= System.Configuration.ConfigurationManager.AppSettings["ApplicationPath.API"] %>' || '').replace(/\/?$/, '/');</script>
    <title>VIETNAM AIR TRAFFIC MANAGEMENT CORPORATION</title>

    <meta name="description" content="AIR TRAFFIC FLOW MANAGEMENT" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <asp:ContentPlaceHolder ID="Scripts" runat="server">
        <link rel="stylesheet" href="<%=Global.ApplicationPath%>/Style/assets/css/bootstrap.min.css" />

        <link rel="stylesheet" href="<%=Global.ApplicationPath%>/Style/assets/font-awesome/4.5.0/css/font-awesome.min.css" />

        <!-- page specific plugin styles; trang Reports khong su dung Select2 -->
        <% if (!Request.AppRelativeCurrentExecutionFilePath.Equals("~/Common/Reports.aspx", StringComparison.OrdinalIgnoreCase)) { %>
        <link rel="stylesheet" href="<%=Global.ApplicationPath%>/Style/assets/css/select2.min.css" />
        <% } %>

        <!-- text fonts -->
        <link rel="stylesheet" href="<%=Global.ApplicationPath%>/Style/assets/css/fonts.googleapis.com.css?v=20260713.1" />

        <!-- ace styles -->
        <link rel="stylesheet" href="<%=Global.ApplicationPath%>/Style/assets/css/ace.min.css" class="ace-main-stylesheet" />

        <!--[if lte IE 9]>
			<link rel="stylesheet" href="<%=Global.ApplicationPath%>/Style/assets/css/ace-part2.min.css" class="ace-main-stylesheet" />
		<![endif]-->
        <link rel="stylesheet" href="<%=Global.ApplicationPath%>/Style/assets/css/ace-skins.min.css" />
        <link rel="stylesheet" href="<%=Global.ApplicationPath%>/Style/assets/css/ace-rtl.min.css" />

        <!--[if lte IE 9]>
		  <link rel="stylesheet" href="<%=Global.ApplicationPath%>/Style/assets/css/ace-ie.min.css" />
		<![endif]-->

        <!-- inline styles related to this page -->

        <!-- ace settings handler -->
        <script src="<%=Global.ApplicationPath%>/Style/assets/js/ace-extra.min.js"></script>

        <!-- HTML5shiv and Respond.js for IE8 to support HTML5 elements and media queries -->

        <!--[if lte IE 8]>
		<script src="<%=Global.ApplicationPath%>/Style/assets/js/html5shiv.min.js"></script>
		<script src="<%=Global.ApplicationPath%>/Style/assets/js/respond.min.js"></script>
		<![endif]-->
        <!--[if !IE]> -->
        <script src="<%=Global.ApplicationPath%>/Style/assets/js/jquery-2.1.4.min.js"></script>
        <link href="<%=Global.ApplicationPath%>/Style/style.css?v=20260713.1" rel="stylesheet" />
        <script src="<%=Global.ApplicationPath%>/Scripts/Lib.js"></script>
        

        <!--Get automatic-->

        <script type="text/javascript">
            $(function () {
                ExcuteFunction();
            });
            function ExcuteFunction() {
                var t = setTimeout("Get_Totals()", 1000);
            }
            function Get_Totals() {
                $.ajax({
                    type: "POST",
                    url: "<%=Global.ApplicationPath%>/Ajax/WebServiceLoadData.asmx/UpdateOnline",
                data: "{}",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (msg) {
                   // var data = msg.d;
                   // $("#loadTotals").html(data);
                   // $("#loadTotalsReport").html(data);

                },
                error: function (msg) { }
            });

        }

        </script>
        <!--End Get automatic-->

    </asp:ContentPlaceHolder>

    <style type="text/css">
        /* Menu riêng cho ATFM_New.Master; giữ nguyên cấu trúc do BindNavigation sinh ra. */
        .atfm-modern-menu {
            min-height: 58px;
            border: 0;
            border-bottom: 1px solid #d7e2ed;
            background: #fff;
            box-shadow: 0 3px 12px rgba(30, 60, 90, .10);
        }

        .atfm-modern-menu .sidebar-shortcuts {
            display: none;
        }

        .atfm-modern-menu .atfm-menu-list {
            display: flex;
            align-items: stretch;
            flex-wrap: wrap;
            gap: 4px;
            padding: 8px 16px;
            border: 0;
            background: transparent;
        }

        .atfm-modern-menu .atfm-menu-list > li {
            position: relative;
            flex: 0 0 auto;
            border: 0;
            border-radius: 7px;
            background: transparent;
            transition: transform .2s ease;
        }

        .atfm-modern-menu .atfm-menu-list > li > a {
            display: flex;
            min-height: 42px;
            align-items: center;
            gap: 8px;
            padding: 9px 14px;
            border: 0;
            border-radius: 7px;
            color: #34495e;
            font-size: 13px;
            font-weight: 600;
            line-height: 20px;
            box-shadow: 0 1px 0 rgba(31,55,78,.03);
            transition: background-color .18s ease, color .18s ease, box-shadow .18s ease, transform .18s ease;
        }

        .atfm-modern-menu .atfm-menu-list > li > a:hover,
        .atfm-modern-menu .atfm-menu-list > li.hover:hover > a {
            background: #edf6ff;
            color: #1769aa;
            box-shadow: inset 0 0 0 1px #d4e9fb;
            transform: translateY(-2px);
        }

        .atfm-modern-menu .atfm-menu-list > li.active > a,
        .atfm-modern-menu .atfm-menu-list > li.active.open > a {
            background: linear-gradient(135deg, #1686c8, #11639d);
            color: #fff;
            box-shadow: 0 3px 8px rgba(17, 99, 157, .24);
        }

        .atfm-modern-menu .atfm-menu-list > li.active > a:before,
        .atfm-modern-menu .atfm-menu-list > li.open > a:before {
            content: "";
            position: absolute;
            top: 5px;
            bottom: 5px;
            left: 0;
            width: 4px;
            border-radius: 0 4px 4px 0;
            background: #8ed2ff;
        }

        .atfm-modern-menu .atfm-menu-list > li > a:hover .menu-icon,
        .atfm-modern-menu .atfm-menu-list > li.active > a .menu-icon {
            filter: drop-shadow(0 2px 3px rgba(20, 92, 143, .28));
            transform: scale(1.08);
        }

        .atfm-modern-menu .atfm-menu-list > li > a .menu-icon,
        .atfm-modern-menu .atfm-menu-list > li > a > .arrow {
            transition: transform .18s ease, filter .18s ease;
        }

        .atfm-modern-menu .atfm-menu-list > li.open > a > .arrow,
        .atfm-modern-menu .atfm-menu-list > li.active.open > a > .arrow {
            transform: rotate(180deg);
        }

        .atfm-modern-menu .atfm-menu-list > li > a .menu-icon {
            width: 28px;
            margin: 0;
            color: inherit;
            font-size: 17px;
            text-align: center;
        }

        .atfm-modern-menu .atfm-menu-list > li > a .menu-icon img {
            width: 24px !important;
            height: 24px !important;
            object-fit: contain;
        }

        .atfm-modern-menu .atfm-menu-list > li > a .menu-text {
            white-space: nowrap;
        }

        .atfm-modern-menu .atfm-menu-list > li > a > .arrow {
            position: static;
            margin-left: 2px;
            color: inherit;
            font-size: 12px;
        }

        .atfm-modern-menu .atfm-menu-list > li > .submenu {
            top: calc(100% + 6px);
            left: 0;
            min-width: 240px;
            padding: 7px;
            border: 1px solid #dce7f0;
            border-radius: 8px;
            background: #fff;
            box-shadow: 0 12px 28px rgba(35, 62, 89, .18);
        }

        .atfm-modern-menu .atfm-menu-list > li > .submenu:before,
        .atfm-modern-menu .atfm-menu-list > li > .submenu:after {
            display: none;
        }

        .atfm-modern-menu .atfm-menu-list .submenu > li > a {
            padding: 9px 12px;
            border: 0;
            border-radius: 6px;
            color: #475b6f;
            line-height: 20px;
        }

        .atfm-modern-menu .atfm-menu-list .submenu > li > a:hover {
            background: #edf6ff;
            color: #1769aa;
        }

        .atfm-modern-menu .atfm-menu-list .submenu > li > a > .menu-icon {
            color: #1686c8;
        }

        @media (max-width: 991px) {
            .atfm-modern-menu {
                max-height: calc(100vh - 48px);
                overflow-y: auto;
                box-shadow: 0 8px 20px rgba(30, 60, 90, .16);
            }

            .atfm-modern-menu .atfm-menu-list {
                display: block;
                padding: 10px;
            }

            .atfm-modern-menu .atfm-menu-list > li {
                width: 100%;
                margin-bottom: 4px;
            }

            .atfm-modern-menu .atfm-menu-list > li > a {
                width: 100%;
            }

            .atfm-modern-menu .atfm-menu-list > li > a > .arrow {
                margin-left: auto;
            }

            .atfm-modern-menu .atfm-menu-list > li > .submenu {
                position: static;
                width: auto;
                margin: 4px 0 6px 36px;
                border-radius: 7px;
                box-shadow: none;
            }
        }

        /* Cụm thông báo và tài khoản trên header. */
        #navbar.atfm-header .atfm-header-action {
            position: relative;
        }

        #navbar.atfm-header .atfm-header-action:has(> .atfm-ai-link),
        #navbar.atfm-header .atfm-header-action.user-min,
        #navbar.atfm-header .atfm-ai-link,
        #navbar.atfm-header .atfm-ai-link:hover,
        #navbar.atfm-header .atfm-ai-link:focus,
        #navbar.atfm-header .atfm-user-button,
        #navbar.atfm-header .atfm-user-button:hover,
        #navbar.atfm-header .atfm-user-button:focus,
        #navbar.atfm-header .atfm-header-action.is-open > .atfm-user-button {
            border-color: transparent !important;
            background: transparent !important;
            box-shadow: none !important;
        }

        #navbar.atfm-header .atfm-notification-button,
        #navbar.atfm-header .atfm-user-button {
            position: relative;
            border: 1px solid rgba(255, 255, 255, .20);
            background: rgba(255, 255, 255, .08);
        }

        #navbar.atfm-header .atfm-notification-badge {
            position: absolute;
            top: -7px;
            right: -6px;
            min-width: 20px;
            height: 20px;
            padding: 0 5px;
            border: 2px solid #1d3f7d;
            border-radius: 10px;
            background: #ef4444;
            color: #fff;
            font: 700 11px/16px Arial, sans-serif;
            text-align: center;
        }

        #navbar.atfm-header .atfm-notification-badge.is-empty {
            display: none;
        }

        #navbar.atfm-header .atfm-user-button {
            gap: 8px;
            border-color: transparent;
            background: transparent;
            color: #fff;
            text-decoration: none;
        }

        #navbar.atfm-header .atfm-user-button:hover,
        #navbar.atfm-header .atfm-user-button:focus,
        #navbar.atfm-header .atfm-header-action.is-open > .atfm-user-button {
            border-color: transparent;
            background: rgba(255, 255, 255, .08);
            color: #fff;
        }

        #navbar.atfm-header .atfm-user-button .user-info {
            max-width: 150px;
            text-align: left;
        }

        #navbar.atfm-header .atfm-header-popup {
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            z-index: 1100;
            display: none;
            overflow: hidden;
            border: 1px solid #d8e1eb;
            border-radius: 10px;
            background: #fff;
            color: #26384a;
            box-shadow: 0 14px 38px rgba(15, 37, 65, .24);
        }

        #navbar.atfm-header .atfm-header-action.is-open > .atfm-header-popup {
            display: block;
            animation: atfmPopupIn .18s ease-out;
        }

        @keyframes atfmPopupIn {
            from { opacity: 0; transform: translateY(-5px); }
            to { opacity: 1; transform: translateY(0); }
        }

        #navbar.atfm-header .atfm-notification-panel {
            width: 390px;
            max-width: calc(100vw - 24px);
        }

        #navbar.atfm-header .atfm-popup-header {
            display: flex;
            min-height: 48px;
            align-items: center;
            justify-content: space-between;
            padding: 0 14px;
            border-bottom: 1px solid #e5ebf1;
            font-weight: 700;
        }

        #navbar.atfm-header .atfm-popup-title i {
            margin-right: 7px;
            color: #1686c8;
        }

        #navbar.atfm-header .atfm-popup-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            white-space: nowrap;
        }

        #navbar.atfm-header .atfm-view-all,
        #navbar.atfm-header .atfm-mark-read {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 5px 0;
            border: 0;
            background: transparent;
            color: #2879b9;
            font-size: 12px;
            cursor: pointer;
            text-decoration: none;
        }

        #navbar.atfm-header .atfm-view-all:hover,
        #navbar.atfm-header .atfm-view-all:focus,
        #navbar.atfm-header .atfm-mark-read:hover,
        #navbar.atfm-header .atfm-mark-read:focus { color: #145f98; }

        #navbar.atfm-header .atfm-mark-read:disabled { color: #9aa8b5; cursor: default; }

        #navbar.atfm-header .atfm-notification-list {
            max-height: 390px;
            overflow-y: auto;
            padding: 10px;
        }

        #navbar.atfm-header .atfm-notification-item {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 10px;
            margin-bottom: 8px;
            padding: 12px;
            border: 1px solid #e0e8f0;
            border-left: 3px solid #f0ad4e;
            border-radius: 8px;
            background: #f8fafc;
            color: #34495e;
            text-decoration: none;
            transform: translateX(0);
            transition: opacity .22s ease, transform .22s ease, max-height .26s ease,
                margin .26s ease, padding .26s ease, border-width .26s ease;
        }

        #navbar.atfm-header .atfm-notification-item.is-removing {
            overflow: hidden;
            max-height: 0 !important;
            margin-bottom: 0;
            padding-top: 0;
            padding-bottom: 0;
            border-top-width: 0;
            border-bottom-width: 0;
            opacity: 0;
            transform: translateX(18px);
        }

        #navbar.atfm-header .atfm-notification-item.is-unread {
            background: #f1f7fd;
            border-left-color: #1686c8;
        }

        #navbar.atfm-header .atfm-notification-copy { min-width: 0; }

        #navbar.atfm-header .atfm-notification-title {
            display: block;
            margin-bottom: 5px;
            font-weight: 700;
        }

        #navbar.atfm-header .atfm-notification-message,
        #navbar.atfm-header .atfm-notification-time {
            display: block;
            color: #66788a;
            font-size: 12px;
            line-height: 1.45;
        }

        #navbar.atfm-header .atfm-notification-time { margin-top: 7px; color: #98a6b5; }

        #navbar.atfm-header .atfm-notification-read-one {
            align-self: end;
            display: inline-flex;
            min-width: 54px;
            height: 30px;
            align-items: center;
            justify-content: center;
            gap: 4px;
            padding: 0 8px;
            border: 1px solid #8fc3e4;
            border-radius: 6px;
            background: #fff;
            color: #2078b2;
            font-size: 11px;
            font-weight: 700;
            cursor: pointer;
        }

        #navbar.atfm-header .atfm-notification-read-one:hover,
        #navbar.atfm-header .atfm-notification-read-one:focus { border-color: #1686c8; background: #eaf5fc; }
        #navbar.atfm-header .atfm-notification-read-one:disabled { opacity: .55; cursor: wait; }

        #navbar.atfm-header .atfm-empty-notification {
            padding: 46px 20px;
            color: #7d8b99;
            text-align: center;
        }

        #navbar.atfm-header .atfm-empty-notification i {
            display: block;
            margin-bottom: 10px;
            color: #b4c1cd;
            font-size: 32px;
        }

        #navbar.atfm-header .atfm-user-panel { width: 260px; }
        #navbar.atfm-header .atfm-user-summary { padding: 16px; background: #f6f9fc; }
        #navbar.atfm-header .atfm-user-name { display: block; font-size: 15px; font-weight: 700; }
        #navbar.atfm-header .atfm-user-role { display: block; margin-top: 3px; color: #8795a3; font-size: 10px; font-weight: 700; letter-spacing: 1px; }
        #navbar.atfm-header .atfm-user-links { margin: 0; padding: 6px 0; list-style: none; }
        #navbar.atfm-header .atfm-user-links > li { border-bottom: 1px solid #edf1f5; }
        #navbar.atfm-header .atfm-user-links > li:last-child { border-bottom: 0; }
        #navbar.atfm-header .atfm-user-links a {
            display: block;
            padding: 11px 16px;
            color: #34495e;
            text-decoration: none;
        }
        #navbar.atfm-header .atfm-user-links a:hover { background: #edf6ff; color: #1769aa; }
        #navbar.atfm-header .atfm-user-links i { width: 24px; color: #5776a3; text-align: center; }
        #navbar.atfm-header .atfm-user-links .atfm-logout a,
        #navbar.atfm-header .atfm-user-links .atfm-logout i { color: #d73737; }

        @media (max-width: 767px) {
            #navbar.atfm-header .atfm-user-button .user-info { display: none; }
            #navbar.atfm-header .atfm-user-button { padding: 5px !important; }
            #navbar.atfm-header .atfm-notification-panel { position: fixed; top: 76px; right: 8px; }
        }

        /* Giao diện chung cho các trang danh sách mở từ menu cấp 2. */
        #main-container .main-content,
        #main-container .page-content {
            background: #fff;
        }

        #main-container .page-content {
            padding: 18px 20px 26px;
        }

        #main-container .page-content .page-header {
            margin: 0 0 14px !important;
            padding: 0 0 10px;
            border-bottom: 1px solid #dbe4ed;
        }

        #main-container .page-content .col-xs-12 > table,
        #main-container .page-content form > table {
            overflow: hidden;
            border: 1px solid #dce5ee !important;
            border-radius: 10px;
            background: #fff;
            box-shadow: 0 5px 18px rgba(31, 55, 78, .10);
        }

        #main-container .page-content .classSearchHeader {
            margin: 0;
            padding: 12px 14px;
            border: 1px solid #e1e8ef;
            border-radius: 8px;
            background: #f8fafc;
            box-shadow: none;
        }

        #main-container .page-content .Grid,
        #main-container .page-content table.Grid {
            overflow: hidden;
            border: 1px solid #dbe4ec !important;
            border-collapse: separate !important;
            border-spacing: 0;
            border-radius: 8px;
            background: #fff;
            box-shadow: 0 3px 12px rgba(31, 55, 78, .08);
        }

        #main-container .page-content .Grid th {
            height: 38px;
            padding: 9px 10px !important;
            border-color: #3281bc !important;
            background: #287fbd !important;
            color: #fff !important;
            font-weight: 600;
            vertical-align: middle;
        }

        #main-container .page-content .Grid td {
            padding: 9px 10px !important;
            border-color: #e4eaf0 !important;
            color: #35475a;
            vertical-align: middle;
        }

        #main-container .page-content .Grid tr:nth-child(even) td { background: #f8fafc; }
        #main-container .page-content .Grid tr:hover td { background: #edf6fd; }

        #main-container .page-content .btn,
        #main-container .page-content input[type="submit"],
        #main-container .page-content input[type="button"] {
            min-height: 34px;
            padding: 7px 14px;
            border: 0;
            border-radius: 6px;
            box-shadow: 0 2px 5px rgba(31, 78, 121, .18);
            font-weight: 600;
            transition: transform .15s ease, box-shadow .15s ease, opacity .15s ease;
        }

        #main-container .page-content .btn:hover,
        #main-container .page-content input[type="submit"]:hover,
        #main-container .page-content input[type="button"]:hover {
            opacity: .92;
            transform: translateY(-1px);
            box-shadow: 0 4px 9px rgba(31, 78, 121, .24);
        }

        #main-container .page-content input[type="text"],
        #main-container .page-content select,
        #main-container .page-content textarea {
            min-height: 36px;
            border: 1px solid #cfdbe7;
            border-radius: 6px !important;
            background: #fff;
            box-shadow: inset 0 1px 2px rgba(31, 55, 78, .05);
        }

        #main-container .page-content input[type="text"]:focus,
        #main-container .page-content select:focus,
        #main-container .page-content textarea:focus {
            border-color: #4b9bd3;
            outline: 0;
            box-shadow: 0 0 0 3px rgba(75, 155, 211, .14);
        }

        #main-container .page-content .pageNavTotal {
            padding: 12px 10px !important;
            background: #fff;
        }

        @media (max-width: 767px) {
            #main-container .page-content { padding: 12px 8px 20px; }
            #main-container .page-content .col-xs-12 { overflow-x: auto; }
            #main-container .page-content .Grid { min-width: 720px; }
        }
    </style>

    <style type="text/css">
        /* Bố cục menu hai vùng: chức năng bên trái, danh sách con bên phải. */
        @media (min-width: 992px) {
            #main-container {
                position: relative;
                display: flex;
                flex-direction: column;
                height: auto !important;
                overflow: visible !important;
                min-height: calc(100vh - 96px);
                background: #fff;
            }

            #main-container > .atfm-workspace {
                --atfm-sidebar-width: 340px;
                position: relative;
                display: flex;
                flex: 1 0 auto;
                height: auto !important;
                overflow: visible !important;
                align-items: stretch;
                min-height: calc(100vh - 186px);
            }

            #sidebar.atfm-modern-menu {
                position: relative;
                z-index: 200;
                float: none;
                flex: 0 0 var(--atfm-sidebar-width);
                width: var(--atfm-sidebar-width);
                margin-right: calc(72px - var(--atfm-sidebar-width));
                min-height: 100%;
                border: 0;
                background: transparent;
                box-shadow: none;
                box-sizing: border-box;
                pointer-events: none;
            }

            #sidebar.atfm-modern-menu:before {
                content: "";
                position: absolute;
                top: 0;
                bottom: 0;
                left: 0;
                z-index: 0;
                width: 100%;
                border-right: 1px solid #d8e3ed;
                background: #f7f9fc;
                box-shadow: 3px 0 12px rgba(35, 62, 89, .07);
                pointer-events: none;
                transition: width .2s cubic-bezier(.4, 0, .2, 1), box-shadow .18s ease;
            }

            #sidebar.atfm-modern-menu .atfm-sidebar-toggle {
                position: absolute;
                top: 12px;
                right: -15px;
                z-index: 45;
                display: flex;
                width: 30px;
                height: 30px;
                align-items: center;
                justify-content: center;
                padding: 0;
                border: 1px solid #c9dbe9;
                border-radius: 50%;
                outline: 0;
                background: #fff;
                color: #1769aa;
                box-shadow: 0 3px 9px rgba(35, 62, 89, .18);
                cursor: pointer;
                pointer-events: auto;
                transition: color .2s ease, background-color .2s ease, transform .28s ease;
            }

            #sidebar.atfm-modern-menu .atfm-sidebar-toggle:hover,
            #sidebar.atfm-modern-menu .atfm-sidebar-toggle:focus {
                background: #1769aa;
                color: #fff;
            }

            #sidebar.atfm-modern-menu .atfm-sidebar-toggle .fa {
                font-size: 15px;
                transition: transform .28s ease;
            }

            #main-container > .atfm-workspace.atfm-sidebar-collapsed #sidebar.atfm-modern-menu {
                box-shadow: none;
            }

            #main-container > .atfm-workspace.atfm-sidebar-collapsed #sidebar.atfm-modern-menu:before {
                width: 72px;
                box-shadow: 2px 0 8px rgba(35, 62, 89, .06);
            }

            #main-container > .atfm-workspace.atfm-sidebar-collapsed #sidebar.atfm-modern-menu .atfm-sidebar-toggle {
                transform: translateX(calc(72px - var(--atfm-sidebar-width)));
            }

            #main-container > .atfm-workspace.atfm-sidebar-transitioning #sidebar.atfm-modern-menu {
                pointer-events: none;
            }

            #main-container > .atfm-workspace.atfm-sidebar-collapsed .atfm-sidebar-toggle .fa {
                transform: rotate(180deg);
            }

            #main-container > .atfm-workspace.atfm-sidebar-collapsed #sidebar .atfm-menu-list {
                width: 72px;
                padding: 10px 7px;
            }

            #main-container > .atfm-workspace.atfm-sidebar-collapsed #sidebar .atfm-menu-list > li {
                border-right: 1px solid #e1e9f0;
                border-left: 1px solid #e1e9f0;
            }

            #main-container > .atfm-workspace.atfm-sidebar-collapsed #sidebar .atfm-menu-list > li > a {
                justify-content: center;
                padding: 10px 8px;
            }

            #main-container > .atfm-workspace.atfm-sidebar-collapsed #sidebar .atfm-menu-list > li > a .menu-icon {
                margin: 0;
            }

            /* Làm nổi bật icon menu cấp 1 đang được chọn khi sidebar thu gọn. */
            #main-container > .atfm-workspace.atfm-sidebar-collapsed #sidebar.atfm-modern-menu .atfm-menu-list > li.atfm-panel-active > a .menu-icon,
            #main-container > .atfm-workspace.atfm-sidebar-collapsed #sidebar.atfm-modern-menu .atfm-menu-list:not(.atfm-has-open-panel) > li.active > a .menu-icon {
                position: relative;
                z-index: 1;
                width: 38px;
                min-width: 38px;
                height: 38px;
                margin: -5px 0;
                border: 1px solid rgba(255, 255, 255, .78);
                border-radius: 11px;
                background: linear-gradient(145deg, #24a5e4 0%, #116aa8 100%);
                box-shadow: 0 0 0 3px rgba(37, 149, 211, .18), 0 6px 14px rgba(17, 91, 145, .34);
                transform: scale(1.04);
                transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
            }

            #main-container > .atfm-workspace.atfm-sidebar-collapsed #sidebar.atfm-modern-menu .atfm-menu-list > li.atfm-panel-active > a .menu-icon img,
            #main-container > .atfm-workspace.atfm-sidebar-collapsed #sidebar.atfm-modern-menu .atfm-menu-list:not(.atfm-has-open-panel) > li.active > a .menu-icon img {
                filter: drop-shadow(0 2px 3px rgba(5, 45, 76, .45));
                transform: scale(1.08);
                transition: transform .2s ease, filter .2s ease;
            }

            #main-container > .atfm-workspace.atfm-sidebar-collapsed #sidebar.atfm-modern-menu .atfm-menu-list > li.atfm-panel-active > a .menu-icon:after,
            #main-container > .atfm-workspace.atfm-sidebar-collapsed #sidebar.atfm-modern-menu .atfm-menu-list:not(.atfm-has-open-panel) > li.active > a .menu-icon:after {
                content: "";
                position: absolute;
                inset: -4px;
                border: 1px solid rgba(102, 204, 255, .48);
                border-radius: 14px;
                pointer-events: none;
                animation: atfmActiveMenuGlow 2.2s ease-in-out infinite;
            }

            @keyframes atfmActiveMenuGlow {
                0%, 100% { opacity: .35; transform: scale(.96); }
                50% { opacity: .95; transform: scale(1.04); }
            }

            #main-container > .atfm-workspace.atfm-sidebar-collapsed #sidebar .atfm-menu-list > li > a .menu-text,
            #main-container > .atfm-workspace.atfm-sidebar-collapsed #sidebar .atfm-menu-list > li > a > .arrow {
                max-width: 0;
                margin: 0;
                opacity: 0;
                visibility: hidden;
            }

            #main-container > .atfm-workspace.atfm-sidebar-collapsed > .main-content {
                width: auto;
            }

            #sidebar.atfm-modern-menu .sidebar-shortcuts {
                display: none !important;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list {
                display: block;
                width: var(--atfm-sidebar-width);
                margin: 0;
                padding: 10px;
                border: 0;
                background: transparent;
                box-sizing: border-box;
                position: relative;
                z-index: 1;
                pointer-events: auto;
                transition: width .16s ease, padding .16s ease;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li {
                position: static !important;
                display: block;
                width: 100%;
                margin: 0;
                border: 1px solid #e1e9f0;
                border-bottom: 0;
                background: #fff;
                overflow: hidden;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li:first-child {
                border-radius: 10px 10px 0 0;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li:last-child {
                border-bottom: 1px solid #e1e9f0;
                border-radius: 0 0 10px 10px;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > a {
                display: flex;
                width: 100%;
                min-height: 48px;
                align-items: center;
                padding: 10px 16px;
                border: 0;
                border-radius: 0;
                color: #34495e;
                background: transparent;
                font-size: 13px;
                font-weight: 600;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > a:hover {
                background: #eaf4fc;
                color: #12679e;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li.atfm-panel-active > a,
            #sidebar.atfm-modern-menu .atfm-menu-list:not(.atfm-has-open-panel) > li.active > a {
                background: linear-gradient(135deg, #1686c8, #11639d);
                color: #fff;
                box-shadow: 0 4px 10px rgba(17, 99, 157, .22);
            }

            #sidebar.atfm-modern-menu .atfm-menu-list.atfm-has-open-panel > li.active:not(.atfm-panel-active) > a {
                background: transparent;
                color: #34495e;
                box-shadow: none;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > a .menu-icon {
                display: inline-flex !important;
                flex: 0 0 30px;
                width: 30px;
                min-width: 30px;
                height: 30px;
                align-items: center;
                justify-content: center;
                margin: 0 9px 0 0;
                color: inherit;
                line-height: 1;
                text-align: center;
                vertical-align: middle;
                overflow: visible;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > a .menu-icon img {
                display: block !important;
                width: 28px !important;
                height: 28px !important;
                max-width: 28px !important;
                max-height: 28px !important;
                margin: 0 !important;
                border: 0;
                object-fit: contain;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > a .menu-icon.fa:before {
                margin: 0;
                line-height: 1;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > a .menu-text {
                flex: 1;
                max-width: 100%;
                overflow: hidden;
                opacity: 1;
                visibility: visible;
                white-space: nowrap;
                text-overflow: ellipsis;
                text-align: left;
                transition: opacity .12s ease, max-width .18s ease, visibility 0s linear 0s;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > a > .arrow {
                position: static;
                max-width: 20px;
                overflow: hidden;
                margin-left: auto;
                color: inherit;
                opacity: 1;
                visibility: visible;
                transform: rotate(-90deg);
                transition: opacity .12s ease, max-width .18s ease, visibility 0s linear 0s;
            }

            /* ACE tự sinh thêm tam giác cho li.active; giao diện mới đã có arrow riêng. */
            #sidebar.atfm-modern-menu .atfm-menu-list > li.active:after,
            #sidebar.atfm-modern-menu .atfm-menu-list > li.active > a:after,
            #sidebar.atfm-modern-menu .atfm-menu-list > li.atfm-panel-active:after,
            #sidebar.atfm-modern-menu .atfm-menu-list > li.atfm-panel-active > a:after {
                display: none !important;
                content: none !important;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list li > b.arrow {
                display: none !important;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu {
                position: absolute !important;
                top: 12px !important;
                right: auto !important;
                bottom: auto !important;
                left: calc(100% + 12px) !important;
                z-index: 40;
                display: none !important;
                width: var(--atfm-submenu-width, 884px);
                max-width: calc(100vw - var(--atfm-sidebar-width) - 36px);
                height: auto;
                min-height: 0;
                max-height: calc(100vh - 132px);
                overflow-y: auto;
                padding: 72px 20px 20px;
                border: 1px solid #cfe0ed;
                border-radius: 16px;
                background: rgba(255, 255, 255, .98);
                box-shadow: 0 18px 42px rgba(24, 67, 102, .2);
                box-sizing: border-box;
                pointer-events: auto;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu.atfm-submenu-visible {
                display: grid !important;
                grid-template-columns: repeat(var(--atfm-submenu-columns, 3), minmax(0, 1fr));
                align-content: start;
                gap: 12px;
                pointer-events: auto;
                animation: atfmSubmenuOpen .2s ease-out;
            }

            @keyframes atfmSubmenuOpen {
                from {
                    opacity: 0;
                    transform: translateX(-8px) scale(.985);
                }
                to {
                    opacity: 1;
                    transform: translateX(0) scale(1);
                }
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu:before {
                content: attr(data-menu-title);
                position: absolute;
                top: 20px;
                right: 20px;
                bottom: auto;
                left: 20px;
                display: block;
                height: auto;
                padding: 0 42px 13px 2px;
                border-bottom: 1px solid #dce7f0;
                border-left: 0;
                color: #155f91;
                font-size: 20px;
                font-weight: 700;
                line-height: 28px;
                pointer-events: none;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu:after {
                content: "\f00a";
                position: absolute;
                top: 20px;
                right: 22px;
                display: flex;
                width: 30px;
                height: 30px;
                align-items: center;
                justify-content: center;
                border-radius: 9px;
                background: #eaf5fc;
                color: #1686c8;
                font-family: FontAwesome;
                font-size: 14px;
                pointer-events: none;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu > li {
                position: relative;
                z-index: 2;
                display: flex;
                border: 0;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu > li > a {
                position: relative;
                display: flex;
                width: 100%;
                min-height: 62px;
                align-items: center;
                padding: 12px 48px 12px 18px;
                overflow: hidden;
                border: 1px solid #d7e4ee;
                border-radius: 12px;
                background: linear-gradient(135deg, #fff 0%, #f7fbff 100%);
                color: #314c64;
                font-weight: 600;
                line-height: 20px;
                box-sizing: border-box;
                box-shadow: 0 4px 12px rgba(35, 78, 112, .08);
                cursor: pointer;
                pointer-events: auto;
                transition: transform .2s ease, border-color .2s ease, background .2s ease, color .2s ease, box-shadow .2s ease;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu > li > a:before {
                content: "";
                position: absolute;
                top: 10px;
                bottom: 10px;
                left: 0;
                width: 4px;
                border-radius: 0 4px 4px 0;
                background: #337ab7;
                transition: width .2s ease, background .2s ease;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu > li > a:after {
                content: "\f105";
                position: absolute;
                right: 14px;
                display: flex;
                width: 28px;
                height: 28px;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                background: #e8f3fb;
                color: #337ab7;
                font-family: FontAwesome;
                font-size: 16px;
                transition: transform .2s ease, background .2s ease, color .2s ease;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu > li > a:hover,
            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu > li > a:focus {
                border-color: #337ab7;
                outline: 0;
                background: linear-gradient(135deg, #337ab7 0%, #24689f 100%);
                color: #fff;
                text-decoration: none;
                transform: translateY(-3px);
                box-shadow: 0 10px 22px rgba(36, 104, 159, .25);
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu > li > a:hover:before,
            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu > li > a:focus:before {
                width: 6px;
                background: #8ed2ff;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu > li > a:hover:after,
            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu > li > a:focus:after {
                background: rgba(255, 255, 255, .2);
                color: #fff;
                transform: translateX(3px);
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu > li > a:active {
                transform: translateY(-1px);
                box-shadow: 0 5px 12px rgba(36, 104, 159, .2);
            }

            /* Không hiển thị arrow/caret của ACE khi hover menu cấp 2. */
            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu > li > b.arrow,
            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu > li > b.arrow:before,
            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu > li > b.arrow:after,
            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu > li:hover > b.arrow {
                display: none !important;
                content: none !important;
                border: 0 !important;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu > li > a > .menu-icon.fa-caret-right {
                display: none !important;
            }

            #main-container > .main-content {
                display: none;
            }

            #main-container > .atfm-workspace > .main-content {
                position: relative;
                z-index: 1;
                flex: 1 1 auto;
                width: auto;
                min-width: 0;
                min-height: 100%;
                height: auto !important;
                overflow: visible !important;
                margin-left: 0 !important;
                padding: 20px;
                background: #fff;
                box-sizing: border-box;
            }

            #main-container > .footer {
                position: relative !important;
                flex: 0 0 auto;
                width: 100%;
                height: auto;
                margin: 0;
                padding: 18px 20px;
                border-top: 1px solid #dce5ec;
                background: #fff;
                box-sizing: border-box;
            }

            #main-container > .atfm-workspace .page-content,
            #main-container > .atfm-workspace .main-content-inner {
                height: auto !important;
                min-height: 0;
                overflow: visible !important;
            }

            #main-container > .footer .footer-inner,
            #main-container > .footer .footer-content {
                position: static;
                width: 100%;
                margin: 0;
                padding: 0;
                border: 0;
                line-height: 24px;
                text-align: center;
                box-sizing: border-box;
            }
        }

        @media (max-width: 991px) {
            #sidebar.atfm-modern-menu .atfm-sidebar-toggle {
                display: none;
            }

            #sidebar.atfm-modern-menu {
                width: 100%;
            }

            #main-container > .atfm-workspace {
                display: block;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu.atfm-submenu-visible {
                position: static;
                display: block !important;
                width: auto;
                max-width: none;
                max-height: none;
                overflow: visible;
                margin: 4px 0 8px 34px;
                padding: 7px;
                border-radius: 8px;
                box-shadow: none;
                animation: none;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu:before,
            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu:after {
                display: none;
            }

            #main-container > .atfm-workspace > .main-content {
                margin-left: 0 !important;
            }

            #main-container > .footer,
            #main-container > .footer .footer-inner,
            #main-container > .footer .footer-content {
                position: static;
                width: 100%;
                height: auto;
                overflow: visible !important;
            }
        }
    </style>

    <style type="text/css">
        /* Header nhận diện VATM dành riêng cho master page mới. */
        #navbar.atfm-header {
            min-height: 96px;
            border: 0;
            background: #1d3f7d;
            box-shadow: 0 2px 8px rgba(19, 45, 86, .20);
        }

        #navbar.atfm-header .navbar-container {
            display: flex;
            height: 96px;
            align-items: center;
            justify-content: space-between;
            padding: 0 22px;
        }

        #navbar.atfm-header .navbar-header {
            float: none !important;
        }

        #navbar.atfm-header .atfm-brand {
            display: flex;
            height: 96px;
            align-items: center;
            padding: 0;
            color: #fff;
            text-decoration: none;
        }

        #navbar.atfm-header .atfm-brand-logo {
            width: 76px;
            height: 76px;
            flex: 0 0 76px;
            object-fit: contain;
        }

        #navbar.atfm-header .atfm-brand-vatm {
            margin: 0 18px 0 13px;
            color: #fff;
            font-family: Arial, sans-serif;
            font-size: 43px;
            font-weight: 800;
            line-height: 1;
            letter-spacing: -1px;
        }

        #navbar.atfm-header .atfm-brand-name {
            padding-left: 18px;
            border-left: 1px solid rgba(255, 255, 255, .40);
            color: #fff;
            font-family: Arial, sans-serif;
            font-size: 15px;
            font-weight: 700;
            line-height: 1.45;
            text-transform: uppercase;
        }

        #navbar.atfm-header .navbar-buttons {
            float: none !important;
            margin-left: auto;
        }

        #navbar.atfm-header .ace-nav {
            display: flex;
            height: 96px;
            align-items: center;
        }

        #navbar.atfm-header .ace-nav > li {
            height: auto;
            border: 0;
            background: transparent;
        }

        #navbar.atfm-header .atfm-notification-button {
            display: flex;
            width: 42px;
            height: 42px;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
            padding: 0;
            border: 1px solid rgba(255, 255, 255, .32);
            border-radius: 50%;
            outline: 0;
            background: rgba(255, 255, 255, .10);
            color: #fff;
            cursor: pointer;
            transition: background-color .2s ease, transform .2s ease;
        }

        #navbar.atfm-header .atfm-notification-button:hover,
        #navbar.atfm-header .atfm-notification-button:focus {
            background: rgba(255, 255, 255, .22);
            color: #fff;
            transform: translateY(-1px);
        }

        #navbar.atfm-header .atfm-notification-button .fa-bell {
            font-size: 19px;
        }

        #navbar.atfm-header .user-min > a.dropdown-toggle {
            display: flex;
            min-height: 52px;
            align-items: center;
            padding: 5px 10px;
            border-radius: 6px;
            background: transparent;
        }

        #navbar.atfm-header .nav-user-photo {
            width: 40px;
            height: 40px;
        }

        @media (max-width: 991px) {
            #navbar.atfm-header,
            #navbar.atfm-header .navbar-container,
            #navbar.atfm-header .atfm-brand {
                min-height: 72px;
                height: 72px;
            }

            #navbar.atfm-header .navbar-container {
                padding: 0 12px;
            }

            #navbar.atfm-header .atfm-brand-logo {
                width: 54px;
                height: 54px;
                flex-basis: 54px;
            }

            #navbar.atfm-header .atfm-brand-vatm {
                margin-right: 0;
                font-size: 30px;
            }

            #navbar.atfm-header .atfm-brand-name {
                display: none;
            }
        }
    </style>



</head>
<body id="Body1" class="no-skin" runat="server">
    <form id="form1" runat="server">
        <cc2:ToolkitScriptManager runat="Server" EnablePartialRendering="true" ID="ScriptManager1" />
        <div id="navbar" class="navbar navbar-default navbar-collapse h-navbar ace-save-state atfm-header">
            <div class="navbar-container ace-save-state" id="navbar-container">
                <div class="navbar-header pull-left">
                    <a href="<%=Global.ApplicationPath%>/Common/ChartReport.aspx" class="navbar-brand atfm-brand">
                        <img class="atfm-brand-logo" src="<%=Global.ApplicationPath%>/images/Logo.png" alt="VATM" />
                        <span class="atfm-brand-vatm">VATM</span>
                        <span class="atfm-brand-name">
                            TỔNG CÔNG TY QUẢN LÝ BAY VIỆT NAM<br />
                            VIET NAM AIR TRAFFIC MANAGEMENT CORPORATION
                        </span>
                    </a>

                    <button class="pull-right navbar-toggle navbar-toggle-img collapsed" type="button" data-toggle="collapse" data-target=".navbar-buttons,.navbar-menu">
                        <span class="sr-only">Toggle user menu</span>

                        <img src="<%=Global.ApplicationPath%>/Style/assets/images/avatars/Login-Manager.png" alt="Login" />
                    </button>

                    <button class="pull-right navbar-toggle collapsed" type="button" data-toggle="collapse" data-target="#sidebar">
                        <span class="sr-only">Toggle sidebar</span>

                        <span class="icon-bar"></span>

                        <span class="icon-bar"></span>

                        <span class="icon-bar"></span>
                    </button>
                </div>

                <div class="navbar-buttons navbar-header pull-right  collapse navbar-collapse" role="navigation">
                    <ul class="nav ace-nav">
                        <li class="atfm-header-action atfm-ai-action"><a class="atfm-ai-link" href="https://backwash-january-glare.ngrok-free.dev" target="_blank" rel="noopener noreferrer" title="Trợ lý AI"><span class="atfm-ai-orb">AI</span></a></li>
