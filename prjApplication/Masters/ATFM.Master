<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="ATFM.Master.cs" Inherits="prjApplication.Masters.ATFM" %>

<%@ Register Assembly="AjaxControlToolkit" Namespace="AjaxControlToolkit" TagPrefix="cc2" %>
<%@ Register Assembly="prjComponents" Namespace="prjComponents" TagPrefix="cc1" %>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta http-equiv="REFRESH" content="5400" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="robots" content="noindex, nofollow" />
    <title>VIETNAM AIR TRAFFIC MANAGEMENT CORPORATION</title>

    <meta name="description" content="AIR TRAFFIC FLOW MANAGEMENT" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0" />
    <asp:ContentPlaceHolder ID="Scripts" runat="server">
        <link rel="stylesheet" href="<%=Global.ApplicationPath%>/Style/assets/css/bootstrap.min.css" />

        <link rel="stylesheet" href="<%=Global.ApplicationPath%>/Style/assets/font-awesome/4.5.0/css/font-awesome.min.css" />

        <!-- page specific plugin styles -->
        <link rel="stylesheet" href="<%=Global.ApplicationPath%>/Style/assets/css/select2.min.css" />

        <!-- text fonts -->
        <link rel="stylesheet" href="<%=Global.ApplicationPath%>/Style/assets/css/fonts.googleapis.com.css" />

        <!-- ace styles -->
        <link rel="stylesheet" href="<%=Global.ApplicationPath%>/Style/assets/css/ace.min.css" class="ace-main-stylesheet" />

        <!--[if lte IE 9]>
			<link rel="stylesheet" href="<%=Global.ApplicationPath%>/Style/assets/css/ace-part2.min.css" class="ace-main-stylesheet" />
		<![endif]-->
        <link rel="stylesheet" href="<%=Global.ApplicationPath%>/Style/assets/css/ace-skins.min.css" />
        <link rel="stylesheet" href="<%=Global.ApplicationPath%>/Style/assets/css/ace-rtl.min.css" />

        <!--[if lte IE 9]>
		  <link rel="stylesheet" href="<%=Global.ApplicationPath%>/Style/assets/css/ace-ie.min.css" />
		<![endif]-->

        <!-- inline styles related to this page -->

        <!-- ace settings handler -->
        <script src="<%=Global.ApplicationPath%>/Style/assets/js/ace-extra.min.js"></script>

        <!-- HTML5shiv and Respond.js for IE8 to support HTML5 elements and media queries -->

        <!--[if lte IE 8]>
		<script src="<%=Global.ApplicationPath%>/Style/assets/js/html5shiv.min.js"></script>
		<script src="<%=Global.ApplicationPath%>/Style/assets/js/respond.min.js"></script>
		<![endif]-->
        <!--[if !IE]> -->
        <script src="<%=Global.ApplicationPath%>/Style/assets/js/jquery-2.1.4.min.js"></script>
        <link href="<%=Global.ApplicationPath%>/Style/style.css" rel="stylesheet" />
        <script src="<%=Global.ApplicationPath%>/Scripts/Lib.js"></script>
        

        <!--Get automatic-->

        <script type="text/javascript">
            $(function () {
                ExcuteFunction();
            });
            function ExcuteFunction() {
                var t = setTimeout("Get_Totals()", 1000);
            }
            function Get_Totals() {
                $.ajax({
                    type: "POST",
                    url: "<%=Global.ApplicationPath%>/Ajax/WebServiceLoadData.asmx/UpdateOnline",
                data: "{}",
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (msg) {
                   // var data = msg.d;
                   // $("#loadTotals").html(data);
                   // $("#loadTotalsReport").html(data);

                },
                error: function (msg) { }
            });

        }

        </script>
        <!--End Get automatic-->

    </asp:ContentPlaceHolder>

    <style type="text/css">
        /* Menu riêng cho ATFM_New.Master; giữ nguyên cấu trúc do BindNavigation sinh ra. */
        .atfm-modern-menu {
            min-height: 58px;
            border: 0;
            border-bottom: 1px solid #d7e2ed;
            background: #fff;
            box-shadow: 0 3px 12px rgba(30, 60, 90, .10);
        }

        .atfm-modern-menu .sidebar-shortcuts {
            display: none;
        }

        .atfm-modern-menu .atfm-menu-list {
            display: flex;
            align-items: stretch;
            flex-wrap: wrap;
            gap: 4px;
            padding: 8px 16px;
            border: 0;
            background: transparent;
        }

        .atfm-modern-menu .atfm-menu-list > li {
            position: relative;
            flex: 0 0 auto;
            border: 0;
            border-radius: 7px;
            background: transparent;
        }

        .atfm-modern-menu .atfm-menu-list > li > a {
            display: flex;
            min-height: 42px;
            align-items: center;
            gap: 8px;
            padding: 9px 14px;
            border: 0;
            border-radius: 7px;
            color: #34495e;
            font-size: 13px;
            font-weight: 600;
            line-height: 20px;
            transition: background-color .18s ease, color .18s ease, box-shadow .18s ease;
        }

        .atfm-modern-menu .atfm-menu-list > li > a:hover,
        .atfm-modern-menu .atfm-menu-list > li.hover:hover > a {
            background: #edf6ff;
            color: #1769aa;
            box-shadow: inset 0 0 0 1px #d4e9fb;
        }

        .atfm-modern-menu .atfm-menu-list > li.active > a,
        .atfm-modern-menu .atfm-menu-list > li.active.open > a {
            background: linear-gradient(135deg, #1686c8, #11639d);
            color: #fff;
            box-shadow: 0 3px 8px rgba(17, 99, 157, .24);
        }

        .atfm-modern-menu .atfm-menu-list > li > a .menu-icon {
            width: 28px;
            margin: 0;
            color: inherit;
            font-size: 17px;
            text-align: center;
        }

        .atfm-modern-menu .atfm-menu-list > li > a .menu-icon img {
            width: 24px !important;
            height: 24px !important;
            object-fit: contain;
        }

        .atfm-modern-menu .atfm-menu-list > li > a .menu-text {
            white-space: nowrap;
        }

        .atfm-modern-menu .atfm-menu-list > li > a > .arrow {
            position: static;
            margin-left: 2px;
            color: inherit;
            font-size: 12px;
        }

        .atfm-modern-menu .atfm-menu-list > li > .submenu {
            top: calc(100% + 6px);
            left: 0;
            min-width: 240px;
            padding: 7px;
            border: 1px solid #dce7f0;
            border-radius: 8px;
            background: #fff;
            box-shadow: 0 12px 28px rgba(35, 62, 89, .18);
        }

        .atfm-modern-menu .atfm-menu-list > li > .submenu:before,
        .atfm-modern-menu .atfm-menu-list > li > .submenu:after {
            display: none;
        }

        .atfm-modern-menu .atfm-menu-list .submenu > li > a {
            padding: 9px 12px;
            border: 0;
            border-radius: 6px;
            color: #475b6f;
            line-height: 20px;
        }

        .atfm-modern-menu .atfm-menu-list .submenu > li > a:hover {
            background: #edf6ff;
            color: #1769aa;
        }

        .atfm-modern-menu .atfm-menu-list .submenu > li > a > .menu-icon {
            color: #1686c8;
        }

        @media (max-width: 991px) {
            .atfm-modern-menu {
                max-height: calc(100vh - 48px);
                overflow-y: auto;
                box-shadow: 0 8px 20px rgba(30, 60, 90, .16);
            }

            .atfm-modern-menu .atfm-menu-list {
                display: block;
                padding: 10px;
            }

            .atfm-modern-menu .atfm-menu-list > li {
                width: 100%;
                margin-bottom: 4px;
            }

            .atfm-modern-menu .atfm-menu-list > li > a {
                width: 100%;
            }

            .atfm-modern-menu .atfm-menu-list > li > a > .arrow {
                margin-left: auto;
            }

            .atfm-modern-menu .atfm-menu-list > li > .submenu {
                position: static;
                width: auto;
                margin: 4px 0 6px 36px;
                border-radius: 7px;
                box-shadow: none;
            }
        }
    </style>

    <style type="text/css">
        /* Bố cục menu hai vùng: chức năng bên trái, danh sách con bên phải. */
        @media (min-width: 992px) {
            #main-container {
                position: relative;
                display: flex;
                flex-direction: column;
                min-height: calc(100vh - 96px);
                background: #fff;
            }

            #main-container > .atfm-workspace {
                position: relative;
                display: flex;
                flex: 1 0 auto;
                align-items: stretch;
                min-height: calc(100vh - 186px);
            }

            #sidebar.atfm-modern-menu {
                position: relative;
                z-index: 20;
                float: none;
                flex: 0 0 27vw;
                width: 27vw;
                min-height: 100%;
                border: 0;
                border-right: 1px solid #d8e3ed;
                background: #f7f9fc;
                box-shadow: 3px 0 12px rgba(35, 62, 89, .07);
                box-sizing: border-box;
                transition: flex-basis .28s ease, width .28s ease, box-shadow .28s ease;
            }

            #sidebar.atfm-modern-menu .atfm-sidebar-toggle {
                position: absolute;
                top: 12px;
                right: -15px;
                z-index: 45;
                display: flex;
                width: 30px;
                height: 30px;
                align-items: center;
                justify-content: center;
                padding: 0;
                border: 1px solid #c9dbe9;
                border-radius: 50%;
                outline: 0;
                background: #fff;
                color: #1769aa;
                box-shadow: 0 3px 9px rgba(35, 62, 89, .18);
                cursor: pointer;
                transition: color .2s ease, background-color .2s ease, transform .28s ease;
            }

            #sidebar.atfm-modern-menu .atfm-sidebar-toggle:hover,
            #sidebar.atfm-modern-menu .atfm-sidebar-toggle:focus {
                background: #1769aa;
                color: #fff;
            }

            #sidebar.atfm-modern-menu .atfm-sidebar-toggle .fa {
                font-size: 15px;
                transition: transform .28s ease;
            }

            #main-container > .atfm-workspace.atfm-sidebar-collapsed #sidebar.atfm-modern-menu {
                flex-basis: 72px;
                width: 72px;
                box-shadow: 2px 0 8px rgba(35, 62, 89, .06);
            }

            #main-container > .atfm-workspace.atfm-sidebar-collapsed .atfm-sidebar-toggle .fa {
                transform: rotate(180deg);
            }

            #main-container > .atfm-workspace.atfm-sidebar-collapsed #sidebar .atfm-menu-list {
                padding: 10px 7px;
            }

            #main-container > .atfm-workspace.atfm-sidebar-collapsed #sidebar .atfm-menu-list > li {
                border-right: 1px solid #e1e9f0;
                border-left: 1px solid #e1e9f0;
            }

            #main-container > .atfm-workspace.atfm-sidebar-collapsed #sidebar .atfm-menu-list > li > a {
                justify-content: center;
                padding: 10px 8px;
            }

            #main-container > .atfm-workspace.atfm-sidebar-collapsed #sidebar .atfm-menu-list > li > a .menu-icon {
                margin: 0;
            }

            #main-container > .atfm-workspace.atfm-sidebar-collapsed #sidebar .atfm-menu-list > li > a .menu-text,
            #main-container > .atfm-workspace.atfm-sidebar-collapsed #sidebar .atfm-menu-list > li > a > .arrow {
                display: none;
            }

            #main-container > .atfm-workspace.atfm-sidebar-collapsed > .main-content {
                width: calc(100vw - 72px);
            }

            #sidebar.atfm-modern-menu .sidebar-shortcuts {
                display: none !important;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list {
                display: block;
                width: 100%;
                margin: 0;
                padding: 10px;
                border: 0;
                background: transparent;
                box-sizing: border-box;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li {
                position: static !important;
                display: block;
                width: 100%;
                margin: 0;
                border: 1px solid #e1e9f0;
                border-bottom: 0;
                background: #fff;
                overflow: hidden;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li:first-child {
                border-radius: 10px 10px 0 0;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li:last-child {
                border-bottom: 1px solid #e1e9f0;
                border-radius: 0 0 10px 10px;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > a {
                display: flex;
                width: 100%;
                min-height: 48px;
                align-items: center;
                padding: 10px 16px;
                border: 0;
                border-radius: 0;
                color: #34495e;
                background: transparent;
                font-size: 13px;
                font-weight: 600;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > a:hover {
                background: #eaf4fc;
                color: #12679e;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li.atfm-panel-active > a,
            #sidebar.atfm-modern-menu .atfm-menu-list:not(.atfm-has-open-panel) > li.active > a {
                background: linear-gradient(135deg, #1686c8, #11639d);
                color: #fff;
                box-shadow: 0 4px 10px rgba(17, 99, 157, .22);
            }

            #sidebar.atfm-modern-menu .atfm-menu-list.atfm-has-open-panel > li.active:not(.atfm-panel-active) > a {
                background: transparent;
                color: #34495e;
                box-shadow: none;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > a .menu-icon {
                width: 30px;
                min-width: 30px;
                margin: 0 9px 0 0;
                color: inherit;
                text-align: center;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > a .menu-text {
                flex: 1;
                white-space: normal;
                text-align: left;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > a > .arrow {
                position: static;
                margin-left: auto;
                color: inherit;
                transform: rotate(-90deg);
            }

            /* ACE tự sinh thêm tam giác cho li.active; giao diện mới đã có arrow riêng. */
            #sidebar.atfm-modern-menu .atfm-menu-list > li.active:after,
            #sidebar.atfm-modern-menu .atfm-menu-list > li.active > a:after,
            #sidebar.atfm-modern-menu .atfm-menu-list > li.atfm-panel-active:after,
            #sidebar.atfm-modern-menu .atfm-menu-list > li.atfm-panel-active > a:after {
                display: none !important;
                content: none !important;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list li > b.arrow {
                display: none !important;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu {
                position: absolute !important;
                top: 0 !important;
                right: auto !important;
                bottom: 0 !important;
                left: 100% !important;
                z-index: 30;
                display: none !important;
                width: 73vw;
                height: auto;
                min-height: 0;
                max-height: none;
                overflow-y: auto;
                padding: 82px 26px 28px;
                border: 0;
                border-left: 1px solid #d8e3ed;
                border-radius: 0;
                background: #f8fafc;
                box-shadow: none;
                box-sizing: border-box;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu.atfm-submenu-visible {
                display: grid !important;
                grid-template-columns: repeat(3, minmax(180px, 1fr));
                align-content: start;
                gap: 12px;
                pointer-events: auto;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu:before {
                content: attr(data-menu-title);
                position: absolute;
                top: 24px;
                right: 26px;
                bottom: auto;
                left: 26px;
                display: block;
                height: auto;
                padding: 0 0 15px;
                border-bottom: 1px solid #dce7f0;
                border-left: 0;
                color: #155f91;
                font-size: 22px;
                font-weight: 700;
                pointer-events: none;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu:after {
                display: none;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu > li {
                position: relative;
                z-index: 2;
                display: flex;
                border: 0;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu > li > a {
                display: flex;
                width: 100%;
                min-height: 48px;
                align-items: center;
                padding: 11px 14px;
                border: 1px solid #e1eaf1;
                border-radius: 8px;
                background: #fff;
                color: #40566b;
                line-height: 20px;
                box-sizing: border-box;
                box-shadow: 0 1px 2px rgba(35, 62, 89, .04);
                cursor: pointer;
                pointer-events: auto;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu > li > a:hover {
                border-color: #bcdcf2;
                background: #eaf5fd;
                color: #12679e;
            }

            #main-container > .main-content {
                display: none;
            }

            #main-container > .atfm-workspace > .main-content {
                flex: 1 1 auto;
                width: 73vw;
                min-height: 100%;
                margin-left: 0 !important;
                padding: 20px;
                background: #fff;
                box-sizing: border-box;
            }

            #main-container > .footer {
                position: relative;
                flex: 0 0 auto;
                width: 100%;
                height: auto;
                margin: 0;
                padding: 18px 20px;
                border-top: 1px solid #dce5ec;
                background: #fff;
                box-sizing: border-box;
            }

            #main-container > .footer .footer-inner,
            #main-container > .footer .footer-content {
                position: static;
                width: 100%;
                margin: 0;
                padding: 0;
                border: 0;
                line-height: 24px;
                text-align: center;
                box-sizing: border-box;
            }
        }

        @media (max-width: 991px) {
            #sidebar.atfm-modern-menu .atfm-sidebar-toggle {
                display: none;
            }

            #sidebar.atfm-modern-menu {
                width: 100%;
            }

            #main-container > .atfm-workspace {
                display: block;
            }

            #sidebar.atfm-modern-menu .atfm-menu-list > li > .submenu.atfm-submenu-visible {
                position: static;
                display: block !important;
                width: auto;
                margin: 4px 0 8px 34px;
            }

            #main-container > .atfm-workspace > .main-content {
                margin-left: 0 !important;
            }

            #main-container > .footer,
            #main-container > .footer .footer-inner,
            #main-container > .footer .footer-content {
                position: static;
                width: 100%;
                height: auto;
            }
        }
    </style>

    <style type="text/css">
        /* Header nhận diện VATM dành riêng cho master page mới. */
        #navbar.atfm-header {
            min-height: 96px;
            border: 0;
            background: #1d3f7d;
            box-shadow: 0 2px 8px rgba(19, 45, 86, .20);
        }

        #navbar.atfm-header .navbar-container {
            display: flex;
            height: 96px;
            align-items: center;
            justify-content: space-between;
            padding: 0 22px;
        }

        #navbar.atfm-header .navbar-header {
            float: none !important;
        }

        #navbar.atfm-header .atfm-brand {
            display: flex;
            height: 96px;
            align-items: center;
            padding: 0;
            color: #fff;
            text-decoration: none;
        }

        #navbar.atfm-header .atfm-brand-logo {
            width: 76px;
            height: 76px;
            flex: 0 0 76px;
            object-fit: contain;
        }

        #navbar.atfm-header .atfm-brand-vatm {
            margin: 0 18px 0 13px;
            color: #fff;
            font-family: Arial, sans-serif;
            font-size: 43px;
            font-weight: 800;
            line-height: 1;
            letter-spacing: -1px;
        }

        #navbar.atfm-header .atfm-brand-name {
            padding-left: 18px;
            border-left: 1px solid rgba(255, 255, 255, .40);
            color: #fff;
            font-family: Arial, sans-serif;
            font-size: 15px;
            font-weight: 700;
            line-height: 1.45;
            text-transform: uppercase;
        }

        #navbar.atfm-header .navbar-buttons {
            float: none !important;
            margin-left: auto;
        }

        #navbar.atfm-header .ace-nav {
            display: flex;
            height: 96px;
            align-items: center;
        }

        #navbar.atfm-header .ace-nav > li {
            height: auto;
            border: 0;
            background: transparent;
        }

        #navbar.atfm-header .atfm-notification-button {
            display: flex;
            width: 42px;
            height: 42px;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
            padding: 0;
            border: 1px solid rgba(255, 255, 255, .32);
            border-radius: 50%;
            outline: 0;
            background: rgba(255, 255, 255, .10);
            color: #fff;
            cursor: pointer;
            transition: background-color .2s ease, transform .2s ease;
        }

        #navbar.atfm-header .atfm-notification-button:hover,
        #navbar.atfm-header .atfm-notification-button:focus {
            background: rgba(255, 255, 255, .22);
            color: #fff;
            transform: translateY(-1px);
        }

        #navbar.atfm-header .atfm-notification-button .fa-bell {
            font-size: 19px;
        }

        #navbar.atfm-header .user-min > a.dropdown-toggle {
            display: flex;
            min-height: 52px;
            align-items: center;
            padding: 5px 10px;
            border-radius: 6px;
            background: rgba(255, 255, 255, .10);
        }

        #navbar.atfm-header .nav-user-photo {
            width: 40px;
            height: 40px;
        }

        @media (max-width: 991px) {
            #navbar.atfm-header,
            #navbar.atfm-header .navbar-container,
            #navbar.atfm-header .atfm-brand {
                min-height: 72px;
                height: 72px;
            }

            #navbar.atfm-header .navbar-container {
                padding: 0 12px;
            }

            #navbar.atfm-header .atfm-brand-logo {
                width: 54px;
                height: 54px;
                flex-basis: 54px;
            }

            #navbar.atfm-header .atfm-brand-vatm {
                margin-right: 0;
                font-size: 30px;
            }

            #navbar.atfm-header .atfm-brand-name {
                display: none;
            }
        }
    </style>



</head>
<body id="Body1" class="no-skin" runat="server">
    <form id="form1" runat="server">
        <cc2:ToolkitScriptManager runat="Server" EnablePartialRendering="true" ID="ScriptManager1" />
        <div id="navbar" class="navbar navbar-default navbar-collapse h-navbar ace-save-state atfm-header">
            <div class="navbar-container ace-save-state" id="navbar-container">
                <div class="navbar-header pull-left">
                    <a href="<%=Global.ApplicationPath%>/Common/ChartReport.aspx" class="navbar-brand atfm-brand">
                        <img class="atfm-brand-logo" src="<%=Global.ApplicationPath%>/images/Logo.png" alt="VATM" />
                        <span class="atfm-brand-vatm">VATM</span>
                        <span class="atfm-brand-name">
                            TỔNG CÔNG TY QUẢN LÝ BAY VIỆT NAM<br />
                            VIET NAM AIR TRAFFIC MANAGEMENT CORPORATION
                        </span>
                    </a>

                    <button class="pull-right navbar-toggle navbar-toggle-img collapsed" type="button" data-toggle="collapse" data-target=".navbar-buttons,.navbar-menu">
                        <span class="sr-only">Toggle user menu</span>

                        <img src="<%=Global.ApplicationPath%>/Style/assets/images/avatars/Login-Manager.png" alt="Login" />
                    </button>

